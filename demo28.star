# ============================================================
# 星语 Step 23 演示：引入 Python 库
# ============================================================
# 星语的 数/文/表/典 本来【就是】Python 的 int/str/list/dict，
# 所以调 Python 不需要任何类型转换 —— 这是它最占便宜的地方。
#
# 语法就一行，写在最外层（预处理指令，跟 载入 一个待遇）：
#
#     引入 "模块名"                   → 前缀用模块名：math_sqrt
#     引入 "模块名" 当 别名           → 前缀用别名：js_dumps
#
# ★ 只能拿【模块级】的名字。math.sqrt 能调，但拿不到
#   「某个对象身上的方法」—— 因为 星语的 x.f(y) 只是 f(x, y) 的写法糖，
#   不是真去 x 身上找属性。
# ============================================================

引入 "math"
引入 "json" 当 js

打印 "══ math：函数 ══"
打印 "  根号16   = " + math_sqrt(16)
打印 "  地板3.7  = " + math_floor(3.7)
打印 "  12和18的公约数 = " + math_gcd(12, 18)
打印 "  0.1+0.2+0.3 = " + math_fsum([0.1, 0.2, 0.3])

打印 ""
打印 "══ math：常量 ══"
打印 "  圆周率 = " + math_pi
打印 "  自然底 = " + math_e

打印 ""
打印 "══ 类型完全对得上，不用转换 ══"
打印 "  math_sqrt(16) 的类型 = " + 类型(math_sqrt(16))
打印 "  math_pi 的类型       = " + 类型(math_pi)
数 = math_sqrt(2) * math_sqrt(2)
打印 "  根号2 的平方 = " + 数

打印 ""
打印 "══ json：星语的表和典直接就能序列化 ══"
配置 = ["名字": "星语", "版本": 23, "特性": ["宏", "闭包", "标号跳出"]]
文本 = js_dumps(配置)
打印 "  序列化：" + 文本
还原 = js_loads(文本)
打印 "  还原后 [" + 类型(还原) + "] 名字 = " + 还原["名字"]
打印 "  版本 + 1 = " + (还原["版本"] + 1)
打印 "  特性个数 = " + 长度(还原["特性"])

打印 ""
打印 "══ Python 报错会翻成人话（还带行号）══"
尝试
    打印 math_sqrt("不是数字")
出错 错
    打印 "  " + 错

尝试
    打印 math_sqrt()
出错 错
    打印 "  " + 错

打印 ""
打印 "══ 撞名时星语自己赢 ══"
定义 长度(东西)
    返回 "我是星语的长度"

打印 "  " + 长度([1, 2, 3])
