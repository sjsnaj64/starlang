# ============================================================
# 星语 Step 10 演示：文件读写 + 文本处理
# ============================================================
# 这一批内置函数是「自举」的前置条件：
#   要读进源码     → 读文件
#   要把源码切成行  → 按行分
#   要一个字符一个字符看 → 字符们
#   要判断「这段像不像数字」 → 是数字

# ---------- ① 写出去，再读回来 ----------
写文件("_试读.txt", "第一行\n第二行\n第三行")
打印 文件在吗("_试读.txt")

原样 = 读文件("_试读.txt")
行们 = 按行分(原样)
打印 "行数 = " + 长度(行们)
打印 "第 2 行是：" + 行们[1]

追加文件("_试读.txt", "\n第四行")
打印 "追加后行数 = " + 长度(按行分(读文件("_试读.txt")))

# ---------- ② 文本处理 ----------
句 = "星尘,小明,小红"
打印 切分(句, ",")
打印 取段(句, 0, 2)
打印 取段(句, -2)
打印 排成(["a", "b", "c"], " - ")
打印 换成(句, ",", " | ")
打印 去空白("      两边有空格      ") + "<"
打印 字符们("星语")
打印 是数字("123")
打印 是数字("-4.5")
打印 是数字("12a")

# ---------- ③ ★ 读自己：数一数本文件有多少行 ----------
源 = 读文件("demo11.star")
打印 "本文件 " + 长度(按行分(源)) + " 行，" + 长度(源) + " 个字符"

# ---------- ④ ★★ 用星语写一个词法器 ----------
# 这是「自举」的第一小步：星语开始能看懂星语的源码了。
定义 切词(源码)
{
    词们 = []
    当前 = ""
    字符表 = 字符们(源码)
    序 = 0
    只要 序 < 长度(字符表)
    {
        c = 字符表[序]
        如果 含有("+-*/() ", c)
        {
            如果 长度(当前) > 0
            {
                追加(词们, 当前)
                当前 = ""
            }
            如果 c != " "
            {
                追加(词们, c)
            }
        }
        否则
        {
            当前 = 当前 + c
        }
        序 = 序 + 1
    }
    如果 长度(当前) > 0
    {
        追加(词们, 当前)
    }
    返回 词们
}

打印 切词("1 + 2 * (3 - 4)")
打印 切词("星尘 * 3 + 小明")
