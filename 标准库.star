# ============================================================
# 星语标准库 starlib —— 全部用星语自己写，一行 Python 都没有
# ============================================================
# 用法：在你的程序最上面写一行
#
#     载入 "标准库.star"
#
# 然后这些函数就能直接用。
#
# ★ 为什么标准库非得用星语写，而不是再塞一堆内建函数？
#
#   ① 内建函数是「语言之外的东西」——它们的能力上限就是宿主语言给你的。
#      用星语写才知道这套语法到底够不够用。
#   ② 写完立刻发现两个真缺口：
#        · 没有整除 → 二分查找算不出整数中点（已经补了 整除()）
#        · 没有匿名函数 → 高阶函数得先定义一个具名函数，啰嗦但能用
#      这就是「写库是给语言做体检」。
#   ③ 顺便成了第四个大 demo：标准库自己就得对着三个实现跑一遍。
#
# ★ 注意：这里不能用「重复」当函数名 —— 它是 只要 的关键字别名。
#   所以列表复制叫「重复成」。
# ============================================================


# ═══════════════════════════════════════════════════════════
# 一、数学
# ═══════════════════════════════════════════════════════════

定义 绝对值(x)
    如果 x < 0
        返回 -x
    返回 x


定义 最大值(a, b)
    如果 a > b
        返回 a
    返回 b


定义 最小值(a, b)
    如果 a < b
        返回 a
    返回 b


定义 求和(表)
    和 = 0
    遍历 项 于 表
        和 += 项
    返回 和


定义 平均(表)
    如果 长度(表) == 0
        返回 0
    返回 求和(表) / 长度(表)


定义 阶乘(n)
    如果 n <= 1
        返回 1
    返回 n * 阶乘(n - 1)


定义 斐波那契(n)
    如果 n <= 1
        返回 n
    返回 斐波那契(n - 1) + 斐波那契(n - 2)


定义 最大公约数(a, b)
    只要 b != 0
        临时 = b
        b = a % b
        a = 临时
    返回 a


定义 是质数(n)
    如果 n < 2
        返回 假
    如果 n == 2
        返回 真
    如果 n % 2 == 0
        返回 假
    点 = 3
    只要 点 * 点 <= n
        如果 n % 点 == 0
            返回 假
        点 = 点 + 2
    返回 真


# ═══════════════════════════════════════════════════════════
# 二、列表
# ═══════════════════════════════════════════════════════════

定义 复制(表)
    # 浅复制。★ 必须要有：星语的列表是「引用」，
    # 直接 a = b 之后改 a 会连 b 一起改掉。
    结果 = []
    遍历 项 于 表
        追加(结果, 项)
    返回 结果


定义 反转(表)
    结果 = []
    点 = 长度(表) - 1
    只要 点 >= 0
        追加(结果, 表[点])
        点 = 点 - 1
    返回 结果


定义 去重(表)
    结果 = []
    遍历 项 于 表
        如果 非 含有(结果, 项)
            追加(结果, 项)
    返回 结果


定义 排序(表, 比较器 = 匿名(甲, 乙) { 返回 甲 < 乙 })
    # 冒泡排序，顺序由 比较器 说了算（不改原表，返回新表）。
    #
    # 比较器(甲, 乙) 返回真 = 「甲 应该排在 乙 前面」——
    # 跟 Python 里 a < b 是一个意思。不传就用默认的升序。
    #
    # ★ 默认值写的是【表达式】不是值：每次调用都重新造一个匿名函数。
    #   这是有意的（跟 Python 的 def f(x=[]) 坑相反）——
    #   默认值不会在多次调用之间被共享、被改坏。
    #
    # ★ 「这一圈换过没有」这个提前收工很重要：
    #   没它的话冒泡永远 O(n²)，有的话已经排好序的表一圈就够（O(n)）。
    结果 = 复制(表)
    长 = 长度(结果)
    圈 = 0
    只要 圈 < 长
        换过 = 假
        点 = 0
        只要 点 < 长 - 1 - 圈
            如果 比较器(结果[点 + 1], 结果[点])
                临时 = 结果[点]
                结果[点] = 结果[点 + 1]
                结果[点 + 1] = 临时
                换过 = 真
            点 = 点 + 1
        如果 非 换过
            跳出
        圈 = 圈 + 1
    返回 结果


定义 排序按(表, 比较器)
    # 老名字，留着是因为 demo 里用过。（其实就是 排序(表, 比较器)）
    返回 排序(表, 比较器)


定义 倒序(表)
    返回 排序(表, 匿名(甲, 乙) { 返回 甲 > 乙 })


定义 索引(表, 目标)
    # 从头找，返回下标。找不到返回 空。
    # ★ 返回 空 而不是 -1 —— 空 一测就出来，-1 会被当成合法下标。
    点 = 0
    遍历 项 于 表
        如果 项 == 目标
            返回 点
        点 += 1
    返回 空


定义 二分找(表, 目标)
    # 二分查找，要求表已经排好序。找不到返回 空。
    #
    # ★ 中点必须用 整除 —— 写的时候才发现星语只有浮点除法，
    #   (0 + 3) / 2 算出来是 1.5，拿去当下标直接报错。
    低 = 0
    高 = 长度(表) - 1
    只要 低 <= 高
        中 = 整除(低 + 高, 2)
        如果 表[中] == 目标
            返回 中
        如果 表[中] < 目标
            低 = 中 + 1
        否则
            高 = 中 - 1
    返回 空


定义 拍平(表)
    # 只摊平一层。[[1,2],[3]] -> [1,2,3]
    结果 = []
    遍历 项 于 表
        如果 类型(项) == "表"
            遍历 里 于 项
                追加(结果, 里)
        否则
            追加(结果, 项)
    返回 结果


定义 重复成(表, 次)
    结果 = []
    圈 = 0
    只要 圈 < 次
        遍历 项 于 表
            追加(结果, 项)
        圈 += 1
    返回 结果


# ---- 高阶函数：星语的函数是「值」，可以直接当参数传 ----

定义 映射(表, 函数)
    结果 = []
    遍历 项 于 表
        追加(结果, 函数(项))
    返回 结果


def 过滤(表, 判断)
    结果 = []
    遍历 项 于 表
        如果 判断(项)
            追加(结果, 项)
    返回 结果


定义 折叠(表, 初值, 函数)
    # 折叠(表, 初值, 函数)：函数拿到 (累计, 当前项)，返回新的累计。
    # 求和只是折叠的一个特例：折叠(表, 0, 加法)
    累计 = 初值
    遍历 项 于 表
        累计 = 函数(累计, 项)
    返回 累计


定义 任意(表, 判断)
    # 有一个满足就算真。★ 一找到就返回真 —— 别傻乎乎全部跑完
    遍历 项 于 表
        如果 判断(项)
            返回 真
    返回 假


定义 全部(表, 判断)
    # 全都满足才算真。★ 一发现不满足就返回假
    遍历 项 于 表
        如果 非 判断(项)
            返回 假
    返回 真


定义 计数(表, 判断)
    几个 = 0
    遍历 项 于 表
        如果 判断(项)
            几个 += 1
    返回 几个


定义 第一个满足(表, 判断)
    # 返回下标，找不到返回 空
    点 = 0
    遍历 项 于 表
        如果 判断(项)
            返回 点
        点 += 1
    返回 空


定义 挑一个(表, 比较器)
    # 比较器(甲, 乙) 返回真 = 「甲 比 乙 更该被挑中」。
    # 想要最大值传 匿名(a,b){返回 a > b}，想要最小值传 a < b。
    如果 长度(表) == 0
        返回 空
    选中 = 表[0]
    点 = 1
    只要 点 < 长度(表)
        如果 比较器(表[点], 选中)
            选中 = 表[点]
        点 = 点 + 1
    返回 选中


定义 拉链(甲, 乙)
    # 把两个表按位置配成一对一对的。长度按短的算，多出来的直接丢掉。
    结果 = []
    短 = 长度(甲)
    如果 长度(乙) < 短
        短 = 长度(乙)
    点 = 0
    遍历 项 于 甲
        如果 点 >= 短
            跳出
        追加(结果, [项, 乙[点]])
        点 += 1
    返回 结果


# ═══════════════════════════════════════════════════════════
# 三、文本
# ═══════════════════════════════════════════════════════════

定义 文反转(文本)
    字们 = 字符们(文本)
    结果 = []
    点 = 长度(字们) - 1
    只要 点 >= 0
        追加(结果, 字们[点])
        点 = 点 - 1
    返回 排成(结果, "")


定义 文重复(文本, 次)
    结果 = ""
    圈 = 0
    只要 圈 < 次
        结果 = 结果 + 文本
        圈 = 圈 + 1
    返回 结果


定义 数数(文本, 子串)
    # 子串出现了几次。★ 空子串要单独拦 —— 切分(文本, "") 会炸。
    如果 子串 == ""
        返回 0
    返回 长度(切分(文本, 子串)) - 1


定义 开头是(文本, 前缀)
    如果 长度(前缀) > 长度(文本)
        返回 假
    返回 取段(文本, 0, 长度(前缀)) == 前缀


定义 结尾是(文本, 后缀)
    长后 = 长度(后缀)
    长文 = 长度(文本)
    如果 长后 > 长文
        返回 假
    返回 取段(文本, 长文 - 长后, 长文) == 后缀


定义 填充左(文本, 宽, 填)
    结果 = 文本
    只要 长度(结果) < 宽
        结果 = 填 + 结果
    返回 结果


定义 填充右(文本, 宽, 填)
    结果 = 文本
    只要 长度(结果) < 宽
        结果 = 结果 + 填
    返回 结果


定义 截断(文本, 宽)
    如果 长度(文本) <= 宽
        返回 文本
    返回 取段(文本, 0, 宽)


# ═══════════════════════════════════════════════════════════
# 四、字典
# ═══════════════════════════════════════════════════════════

定义 取值或(字典, 键, 默认)
    # 取不到就给默认值。★ 必须先用 含有() 问一下，
    # 因为直接下标取不到会抛错（这是好事，别改成静默返回 空）。
    如果 含有(字典, 键)
        返回 字典[键]
    返回 默认


定义 键排序(字典)
    返回 排序(键们(字典))


定义 合并(甲, 乙)
    # 乙里的键盖掉甲里的同名字。返回新字典，不动原来两个。
    结果 = [:]
    遍历 键 于 甲
        结果[键] = 甲[键]
    遍历 键 于 乙
        结果[键] = 乙[键]
    返回 结果
