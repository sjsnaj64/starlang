# ============================================================
# 星语 Step 16 演示：匿名函数
# ============================================================
# 之前想用高阶函数，得先在外面写一个具名函数再用：
#
#     定义 翻倍(x)
#         返回 x * 2
#     打印 映射([1,2,3], 翻倍)
#
# 现在可以当场造：
#
#     打印 映射([1,2,3], 匿名(x) { 返回 x * 2 })
#
# ★ 匿名函数和具名函数在【运行时完全一样】——
#   都是 Func，都带闭包。区别只有一条：这个名字有没有人叫得出来。
# ============================================================

载入 "标准库.star"

数们 = [1, 2, 3, 4, 5, 6]

打印 "══ 当场造函数 ══"
打印 "翻倍  = " + 映射(数们, 匿名(x) { 返回 x * 2 })
打印 "平方  = " + 映射(数们, 匿名(x) { 返回 x * x })
打印 "双数  = " + 过滤(数们, 匿名(x) { 返回 x % 2 == 0 })

# ★ 多行也行 —— 花括号里有明确的 } 收尾，不用担心到哪结束
打印 "复杂  = " + 映射(数们, 匿名(x) {
    平方 = x * x
    返回 平方 + 1
})

打印 ""
打印 "══ 折叠（三参数，用匿名最舒服）══"
打印 "求和  = " + 折叠(数们, 0, 匿名(a, b) { 返回 a + b })
打印 "求积  = " + 折叠(数们, 1, 匿名(a, b) { 返回 a * b })
# ★ 多行的匿名函数里想写 如果，得用 { } 写块 —— 缩进块在花括号里不成立
打印 "最大值 = " + 折叠(数们, 0, 匿名(a, b) {
    如果 b > a { 返回 b }
    返回 a
})

打印 ""
打印 "══ 匿名函数也是闭包 ══"
# 这个函数返回一个函数 —— 返回的是「匿名」造出来的那种
定义 造乘法器(系数)
    返回 匿名(x) { 返回 x * 系数 }

乘三 = 造乘法器(3)
乘十 = 造乘法器(10)
打印 "乘三(7) = " + 乘三(7)
打印 "乘十(7) = " + 乘十(7)
打印 "两个不一样：乘三 = " + 乘三
打印 "              乘十 = " + 乘十

打印 ""
打印 "══ 当场用、当场扔 ══"
# 「只跑一次」的东西不用起名字，这正是匿名的意义
排序结果 = 排序([5, 2, 9, 1])
打印 "排序后 = " + 排序结果
打印 "反着看 = " + 映射(反转(排序结果), 匿名(x) { 返回 "第" + x + "名" })
