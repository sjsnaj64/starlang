载入 "标准库.star"

打印 "══ 随机数：同一种子 → 同一串（所以三家能对上）══"
随机种子(42)
打印 "  " + 随机()
打印 "  " + 随机()
打印 "  " + 随机()

随机种子(42)
打印 "  重设同一个种子 → " + 随机()

打印 ""
打印 "══ 随机整数 / 随机挑 / 洗牌 ══"
随机种子(7)
点数们 = []
次 = 0
只要 次 < 8
    追加(点数们, 随机整数(1, 6))
    次 += 1
打印 "  8 次掷骰子：" + 点数们

名字们 = ["甲", "乙", "丙", "丁", "戊"]
随机种子(2026)
打印 "  随机挑一个：" + 随机挑(名字们)
打印 "  洗牌之后：" + 洗牌(复制(名字们))
打印 "  洗牌不碰原表：" + 名字们

打印 ""
打印 "══ 四舍五入（2.5 必须进到 3，不是银行家舍入）══"
打印 "  2.5    → " + 四舍五入(2.5)
打印 "  3.5    → " + 四舍五入(3.5)
打印 "  -2.5   → " + 四舍五入(-2.5)
打印 "  2.675 取两位 → " + 四舍五入(2.675, 2)
打印 "  3.14159 取三位 → " + 四舍五入(3.14159, 3)

打印 ""
打印 "══ 列表补充 ══"
打印 "  最大项 [3, 9, 2, 7] = " + 最大项([3, 9, 2, 7])
打印 "  最小项 [3, 9, 2, 7] = " + 最小项([3, 9, 2, 7])
打印 "  切片 [0,1,2,3,4] 从1到4 = " + 切片([0, 1, 2, 3, 4], 1, 4)
打印 "  拼接 [1,2] + [3,4] = " + 拼接([1, 2], [3, 4])
打印 "  空表最大项 = " + 最大项([])

打印 ""
打印 "══ 删键 ══"
配置 = ["名字": "星语", "版本": 25, "临时": "用完就扔"]
打印 "  删掉「临时」，拿回：" + 删键(配置, "临时")
打印 "  剩下的键：" + 键排序(配置)

打印 ""
打印 "══ 时间（这几条会变，所以只验格式不验值）══"
今天的样子 = 今天()
打印 "  今天的长这样：" + 今天的样子 + "，长度 " + 长度(今天的样子)
# ★ 现在时刻() 不打印值 —— 三家是【先后】跑的，跨了秒就不一致了。
#   这种「不确定的」东西只能验形状。
打印 "  现在时刻是 8 个字符：" + 长度(现在时刻())
打印 "  现在的时间戳是个数字：" + 类型(现在())
打印 "  时间戳(2026, 11, 21) → " + 格式化时间(时间戳(2026, 11, 21), "%Y年%m月%d日")
