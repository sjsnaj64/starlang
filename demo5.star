# ============================================================
# 星语 Step 5 演示：不改原函数，往里织代码
# ============================================================
# 两种标号写法都认：
#     打印 价格  @step1      ← 好打
#     打印 价格  #@step1     ← 多一个字符，但去掉标号功能后还能当注释跑

# ---------- ① 往「开头 / 第 k 条之后 / 结尾」插 ----------
定义 打招呼(名字)
{
    打印 "原始第一行"
    打印 名字
}

# ★ 下面三块全都在改 打招呼，但 打招呼 一个字都不用动
插入 打招呼 开头
{
    打印 "【织入】进门前"
}

插入 打招呼 1
{
    打印 "【织入】第一行之后"
}

插入 打招呼 结尾
{
    打印 "【织入】出门后"
}

打招呼("星尘")

# ---------- ② 同一句出现两次，怎么分？→ 打标号 ----------
# 这就是「按文本匹配」做不到、而标号能做的事：
# 两行长得一模一样，但标号不同，各插各的。
定义 流程()
{
    打印 "重复的一句"   @step1
    打印 "中间夹一句"
    打印 "重复的一句"   @step2
}

插入 标号 step1
{
    打印 "【只在第一个后面】"
}

插入 标号 step2
{
    打印 "【只在第二个后面】"
}

流程()

# ---------- ③ #@ 写法（等价的另一种风格） ----------
定义 结算(价格)
{
    打印 价格        #@底价
    打印 价格 * 2
}

插入 标号 底价
{
    打印 价格 + 1
}

结算(10)
