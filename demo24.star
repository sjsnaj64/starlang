# ============================================================
# 星语 Step 19 演示：遍历循环  遍历 项 于 表
# ============================================================
# 之前「每个元素做一遍」得手写三件套：
#
#     点 = 0
#     只要 点 < 长度(表)
#         项 = 表[点]
#         … 干活 …
#         点 += 1
#
# 现在一行，而且不会写错边界（`<` 写成 `<=` 就崩）。
# ============================================================

载入 "标准库.star"

打印 "══ 遍历列表 ══"
遍历 数 于 [3, 1, 4, 1, 5]
    打印 "  " + 数

打印 ""
打印 "══ 遍历文本：一个字一个字过 ══"
遍历 字 于 "星语"
    打印 "  " + 字

打印 ""
打印 "══ 遍历字典：给的是【键】 ══"
分数 = ["语文": 92, "数学": 88, "英语": 95]
遍历 科目 于 分数
    打印 "  " + 科目 + " = " + 分数[科目]
# ★ 要值也行：遍历 分 于 值们(分数)

打印 ""
打印 "══ 累加：再也不用管下标 ══"
总分 = 0
遍历 分 于 值们(分数)
    总分 += 分
打印 "  总分 = " + 总分
打印 "  平均 = " + (总分 / 长度(值们(分数)))

打印 ""
打印 "══ 跳出 / 继续 照常能用 ══"
打印 "  跳过不及格的，遇到 100 就停："
遍历 成绩 于 [88, 55, 92, 100, 61]
    如果 成绩 < 60
        继续
    如果 成绩 == 100
        跳出
    打印 "    " + 成绩

打印 ""
打印 "══ 遍历结束后变量还在（最后一项）══"
遍历 末项 于 ["甲", "乙", "丙"]
    安静 = 末项
打印 "  末项 = " + 末项

打印 ""
打印 "══ 嵌套遍历 ══"
遍历 行 于 [1, 2, 3]
    一行 = ""
    遍历 列 于 [10, 20]
        一行 += 行 * 列 + " "
    打印 "  " + 一行

打印 ""
打印 "══ ★ 快照：边遍历边改不会乱 ══"
原表 = [1, 2, 3]
遍历 项 于 原表
    追加(原表, 项 * 10)
打印 "  遍历中追加了三次，原表现在有 " + 长度(原表) + " 个元素"
打印 "  但每一轮拿到的还是开始那一刻的三项，没有无限下去"
打印 "  原表 = " + 原表

打印 ""
打印 "══ 不用 遍历 的对照：老写法 ══"
数们 = [3, 1, 4]
点 = 0
只要 点 < 长度(数们)
    打印 "  老写法 " + 数们[点]
    点 += 1

打印 ""
打印 "══ 遍历数字会报错 ══"
尝试
    遍历 项 于 42
        打印 项
出错 错
    打印 "  " + 错
