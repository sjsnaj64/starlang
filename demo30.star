# ============================================================
# 星语 Step 26 演示：引入的模块可以用点号
# ============================================================
# 以前只能写 math_sqrt(16)。现在两种都行：
#
#     引入 "math"
#     打印 math.sqrt(16)      ← 真属性访问（只有引入的模块才有）
#     打印 math_sqrt(16)      ← 老写法，还留着
#
# ★ 普通值的点号一个字没动：
#     话.长度()  =  长度(话)    ← 还是语法糖
# ============================================================

引入 "math"
引入 "json" 当 js

打印 "══ 模块.函数(实参) ══"
打印 "  根号16 = " + math.sqrt(16)
打印 "  地板   = " + math.floor(3.7)
打印 "  公约数 = " + math.gcd(12, 18)

打印 ""
打印 "══ 模块.常量（不带括号）══"
打印 "  圆周率 = " + math.pi
打印 "  自然底 = " + math.e
数 = math.sqrt(2) * math.sqrt(2)
打印 "  根号2的平方 = " + 数

打印 ""
打印 "══ 别名也一样能用 ══"
配置 = ["名字": "星语", "版本": 26]
文本 = js.dumps(配置)
打印 "  " + js.loads(文本)["名字"]

打印 ""
打印 "══ 链起来写 ══"
打印 "  两位小数：" + math.floor(math.pi * 100) / 100

打印 ""
打印 "══ 普通值的点号还是老规矩（语法糖）══"
话 = "你好世界"
打印 "  " + 话.长度()
打印 "  " + 话.取段(0, 2)
表 = [1, 2, 3]
打印 "  " + 表.长度()

打印 ""
打印 "══ 模块名写错会说清楚 ══"
尝试
    打印 math.根本没有这个
出错 错
    打印 "  " + 错
