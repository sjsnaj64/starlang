# ============================================================
# csv转md.star —— 把 CSV 转成 Markdown 表格
# ============================================================
# 用法（从标准输入读，往标准输出写）：
#
#     cmd /c "python starlang.py csv转md.star < 数据.csv > 表格.md"
#
# ★ 这是「吃狗粮」的产物：全程只用星语，一行 Python 都没有。
#   第一版写出来之后，逼着语言补了两个内置函数：
#       · 显示宽度(文本)  —— 中文占 2 格，按字符数对齐永远歪
#       · 结束程序(码)    —— 顶层不能 `返回`，没法「检查完就收工」
# ============================================================

载入 "标准库.star"


# ─────────────────────────────────────────────────
#  一、按【显示宽度】补齐（不是按字符数）
# ─────────────────────────────────────────────────
# 长度("姓名")   = 2     但屏幕上占 4 格
# 长度("abcd")   = 4     也是 4 格
# 所以表格要用 显示宽度 算，不然中文列会歪。
定义 补齐(文本, 目标宽)
    实际 = 显示宽度(文本)
    如果 实际 >= 目标宽
        返回 文本
    返回 文本 + 文重复(" ", 目标宽 - 实际)


# ─────────────────────────────────────────────────
#  二、解析一行 CSV（整个工具里唯一有难度的地方）
# ─────────────────────────────────────────────────
# 坑：引号里的逗号**不是分隔符**。
#     张三,"喜欢猫,狗和鸟"    ← 这是 2 列，不是 3 列
# 引号里还能用双写的引号表示一个真引号："他说""你好""" → 他说"你好"
定义 解析一行(行)
    列们 = []
    当前 = ""
    在引号里 = 假
    字们 = 字符们(行)
    点 = 0
    只要 点 < 长度(字们)
        字 = 字们[点]
        如果 在引号里
            如果 字 == "\""
                如果 点 + 1 < 长度(字们) 且 字们[点 + 1] == "\""
                    当前 += "\""
                    点 += 1
                否则
                    在引号里 = 假
            否则
                当前 += 字
        否则
            如果 字 == "\""
                在引号里 = 真
            否则如果 字 == ","
                追加(列们, 当前)
                当前 = ""
            否则
                当前 += 字
        点 += 1
    追加(列们, 当前)
    返回 列们


# ─────────────────────────────────────────────────
#  三、主流程
# ─────────────────────────────────────────────────
原文 = 读全部()

如果 去空白(原文) == ""
    打印 "（输入是空的）"
    结束程序(1)

# 去掉空行
行们 = []
遍历 行 于 按行分(原文)
    如果 去空白(行) != ""
        追加(行们, 行)

如果 长度(行们) == 0
    打印 "（没有数据）"
    结束程序(1)

# 每行切成列
表们 = []
遍历 行 于 行们
    追加(表们, 解析一行(行))

# 一共几列（按最宽的一行算，短行后面补空白）
列数 = 0
遍历 行 于 表们
    如果 长度(行) > 列数
        列数 = 长度(行)

# 每列该多宽：按【显示宽度】算，最少 2
宽度们 = []
点 = 0
只要 点 < 列数
    追加(宽度们, 2)
    点 += 1

遍历 行 于 表们
    列 = 0
    遍历 格 于 行
        宽 = 显示宽度(格)
        如果 宽 > 宽度们[列]
            宽度们[列] = 宽
        列 += 1

# 拼成 Markdown
输出行们 = []
第几行 = 0

遍历 行 于 表们
    格们 = []
    列 = 0
    遍历 格 于 行
        追加(格们, 补齐(格, 宽度们[列]))
        列 += 1
    # 短行补空白格，别让表格塌掉
    只要 列 < 列数
        追加(格们, 文重复(" ", 宽度们[列]))
        列 += 1
    追加(输出行们, "| " + 排成(格们, " | ") + " |")

    如果 第几行 == 0
        分隔们 = []
        遍历 宽 于 宽度们
            追加(分隔们, 文重复("-", 宽))
        追加(输出行们, "| " + 排成(分隔们, " | ") + " |")
    第几行 += 1

打印 排成(输出行们, "\n")
