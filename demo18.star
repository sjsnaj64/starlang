# ============================================================
# 星语 Step 15 演示：用标准库写点真东西
# ============================================================
# 标准库.star 里一行 Python 都没有，全是星语。
# 这个 demo 就是「语言到底能不能用来干活」的答案。
# ============================================================

载入 "标准库.star"


# ---------- 高阶函数要先有具名函数（星语还没有匿名函数）----------
定义 翻倍(x)
    返回 x * 2

定义 是双数(x)
    返回 x % 2 == 0

定义 加法(a, b)
    返回 a + b

定义 不及格吗(x)
    返回 x < 60


打印 "══ 数学 ══"
打印 "绝对值(-7)        = " + 绝对值(-7)
打印 "最大公约数(48,18) = " + 最大公约数(48, 18)
打印 "阶乘(10)          = " + 阶乘(10)
打印 "斐波那契(15)      = " + 斐波那契(15)
打印 "是质数(97)        = " + 是质数(97)
打印 "是质数(91)        = " + 是质数(91)


打印 ""
打印 "══ 列表 ══"
数们 = [3, 1, 4, 1, 5, 9, 2, 6]
打印 "原表   = " + 数们
打印 "排序   = " + 排序(数们)
打印 "反转   = " + 反转(数们)
打印 "去重   = " + 去重(数们)
打印 "拍平   = " + 拍平([[1, 2], [3], 4])
打印 "重复成 = " + 重复成([1, 2], 3)
打印 "求和   = " + 求和(数们)
打印 "平均   = " + 平均(数们)

# ★ 原表没被改动 —— 排序() 是返回新表，不是原地排
打印 "原表还是 = " + 数们

排好 = 排序(数们)
打印 "二分找 5 = " + 二分找(排好, 5)
打印 "二分找 8 = " + 二分找(排好, 8)
打印 "索引找 5 = " + 索引(数们, 5)
打印 "索引找 8 = " + 索引(数们, 8)


打印 ""
打印 "══ 高阶函数 ══"
打印 "映射翻倍   = " + 映射(数们, 翻倍)
打印 "过滤双数   = " + 过滤(数们, 是双数)
打印 "折叠求和   = " + 折叠(数们, 0, 加法)


打印 ""
打印 "══ 文本 ══"
话 = "编程语言真有意思"
打印 "原话     = " + 话
打印 "反转     = " + 文反转(话)
打印 "几个「言」= " + 数数(话, "言")
打印 "开头是编程 = " + 开头是(话, "编程")
打印 "结尾是意思 = " + 结尾是(话, "意思")
打印 "结尾是猫   = " + 结尾是(话, "猫")
打印 "填零     = [" + 填充左("7", 5, "0") + "]"
打印 "填点     = [" + 填充右("ab", 6, ".") + "]"
打印 "截断     = " + 截断(话, 4)
打印 "文重复   = " + 文重复("喵", 4)


打印 ""
打印 "══ 字典 ══"
分数 = ["语文": 92, "数学": 88, "英语": 95]
打印 "数学     = " + 取值或(分数, "数学", 0)
打印 "物理     = " + 取值或(分数, "物理", -1)
打印 "键排序   = " + 键排序(分数)
补考 = ["数学": 91, "物理": 77]
打印 "合并     = " + 合并(分数, 补考)


打印 ""
打印 "══ 真用它干件事：期末成绩单 ══"
成绩 = [88, 92, 79, 95, 61, 100, 73]
排好分 = 排序(成绩)
打印 "原始：    " + 成绩
打印 "从小到大：" + 排好分
打印 "最低：    " + 排好分[0]
打印 "最高：    " + 排好分[长度(排好分) - 1]
打印 "平均：    " + 平均(成绩)
打印 "不及格人数：" + 长度(过滤(成绩, 不及格吗))
