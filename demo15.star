# ============================================================
# 星语 Step 8.5 演示：宏卫生化 Hygiene
# ============================================================
# 【不卫生】是什么意思：
#   宏展开 = 把宏体的代码「原样倒进」调用处。
#   于是宏体里随手起的名字（临时、和、序、计数……）
#   就会跟调用者自己的变量【撞在一起】—— 撞了就悄悄算错，最难查的那种错。
#
# 【卫生化】怎么治：
#   宏体【自己声明】的局部变量，展开时统统换成一个绝不会撞的名字：
#
#       和  →  和#1        （#1 是全局递增的编号）
#
#   Scheme / Racket 管这叫 gensym（generate symbol）。
#   # 这个字符在星语里是注释符，用户根本写不进名字，
#   所以 名字#1 这种形式保证了「用户永远猜不到、也就撞不上」。
#
# ⚠️ 只做了一半，而且是【故意】的：
#   · 宏体自己声明的名字 → 改名隔离（防止宏踩调用者）
#   · 宏体里的自由变量   → 仍然看调用者的环境
#   后一半不能动，否则「宏能看到调用者的变量」这个特性就没了（见 ④）。


# ------------------------------------------------------------
# ① 宏体自己的局部变量，不再踩调用者
# ------------------------------------------------------------
# 宏里用「和」「序」这种烂大街的名字也不要紧了。

宏 求和并报(n)
{
    和 = 0
    序 = 0
    只要 序 < n
    {
        和 = 和 + 序
        序 = 序 + 1
    }
    打印 "  宏内算出来：和=" + 和
}

和 = 777
序 = 888
求和并报(5)
打印 "  调用者的 和=" + 和
打印 "  调用者的 序=" + 序
# 不卫生的版本：这两行会变成 10 和 5 —— 调用者的变量被宏悄悄改了。


# ------------------------------------------------------------
# ② 反方向：实参里的变量，不会被宏体捕获
# ------------------------------------------------------------
# 这半边更隐蔽：宏体为了保护自己起了个「临时」，
# 结果把调用者传进来的块里那个「临时」给顶掉了。

宏 执行(动作)
{
    临时 = "宏体自己造的"
    打印 "  宏内 临时=" + 临时
    动作
}

临时 = "调用者的"
执行({
    打印 "  实参里看到 临时=" + 临时
})
# 卫生化之后这里应该是「调用者的」；
# 不卫生的版本会打印「宏体自己造的」—— 而且完全不报错。


# ------------------------------------------------------------
# ③ 宏体里定义函数，也不会撞调用者的同名函数
# ------------------------------------------------------------
# 函数名也是「宏体自己声明的名字」，一样要隔离。

宏 跑一遍()
{
    定义 帮手(x)
    {
        返回 x * 2
    }
    打印 "  宏内的 帮手(5)=" + 帮手(5)
}

定义 帮手(x)
{
    返回 "我是调用者的帮手"
}
跑一遍()
打印 "  调用者的 帮手(5)=" + 帮手(5)


# ------------------------------------------------------------
# ④ 仍然保留：自由变量照旧看调用者
# ------------------------------------------------------------
# 「自由变量」= 宏体里【只读、从不赋值】的名字。
# 这类名字不属于宏自己，所以不改名 —— 这正是宏比函数强的地方。

宏 报数(前缀)
{
    打印 前缀 + 计数器
}

计数器 = 100
报数("  现在计数是 ")
计数器 = 200
报数("  现在计数是 ")


# ------------------------------------------------------------
# ⑤ 最经典的例子：交换
# ------------------------------------------------------------
# 这个宏几乎每本讲卫生宏的书都会拿它开刀，因为它是【最容易踩雷】的形状：
#   宏体里必须有个临时变量，而「临时」是全世界最容易被调用者撞上的名字。
#
# 顺带说明：参数放在赋值号【左边】也是支持的，不然「交换」根本无从写起。

宏 交换(a, b)
{
    临时 = a
    a = b
    b = 临时
}

x = 1
y = 2
交换(x, y)
打印 "  x=" + x + "   y=" + y

# ↓ 真正的地雷：调用者自己也有个「临时」
x = 10
临时 = 20
交换(x, 临时)
打印 "  x=" + x + "   临时=" + 临时
# 不卫生的版本会变成：x=20、临时=20
# 因为展开后是  临时 = x / x = 临时 / 临时 = 临时  ← 第三行取到的是中间值。


# ------------------------------------------------------------
# ⑥ 同一个宏连调两次，两套临时变量互不干扰
# ------------------------------------------------------------
# 每次展开都会拿到一个新的编号（临时#1、临时#2…），所以嵌套调用也安全。

x = 100
y = 200
z = 300
交换(x, y)
交换(y, z)
打印 "  连换两次后：x=" + x + "  y=" + y + "  z=" + z
