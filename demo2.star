# 星语 Step 2 演示：变量 + 打印
# 运行:  python starlang.py demo2.star
# 透视:  python starlang.py --all demo2.star

# ---- 1. 变量会「记住」东西 ----
星尘 = 100
print 星尘

# ---- 2. 变量可以参与运算 ----
星尘 = 星尘 + 50
print 星尘

# ---- 3. 中文名、英文名、下划线都行 ----
hp = 250
max_hp = 1000
print hp / max_hp

# ---- 4. 右边用的是「旧值」，算完才覆盖 ----
x = 1
x = x + 1
x = x + 1
print x

# ---- 5. 变量也能出现在比较里 ----
print 星尘 > 100

# ---- 6. 光秃秃一条表达式会打印出值（当计算器用）----
1 + 2 * 3
(1 + 2) * 3

# ---- 7. 未定义的变量会报错（把下面注释去掉试试）----
# print 不存在的东西
