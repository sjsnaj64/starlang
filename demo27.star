# ============================================================
# 星语 Step 22 演示：带标号的跳出   跳出 标号
# ============================================================
# 多重循环里想「一口气全退出去」，以前只能挂标志变量：
#
#     还在找 = 真
#     只要 还在找
#         只要 还在找
#             只要 还在找
#                 如果 找到了
#                     还在找 = 假
#
# 三层循环要检查三次，而且中间的语句还会多跑一圈。
# 现在给循环起个名字，直接点名叫它停：
#
#     只要 行 < 9 @外层
#         只要 列 < 9
#             跳出 外层
#
# ★ 标号就是行尾那个 @名字 —— 跟「插入」用的是同一套标号。
# ============================================================

载入 "标准库.star"

打印 "══ 基本用法：两层一次退干净 ══"
轮数 = 0
只要 真 @外面
    轮数 += 1
    圈数 = 0
    只要 真
        圈数 += 1
        如果 圈数 > 2
            跳出 外面
    打印 "  这行不该被打印"
打印 "  外层跑了 " + 轮数 + " 轮，内层跑了 " + 圈数 + " 圈"

打印 ""
打印 "══ 三层嵌套也只要一句话 ══"
找到 = 空
遍历 行 于 [1, 2, 3] @扫全表
    遍历 列 于 [1, 2, 3]
        遍历 深 于 [1, 2, 3]
            积 = 行 * 列 * 深
            如果 积 == 18
                找到 = "行" + 行 + "×列" + 列 + "×深" + 深
                跳出 扫全表
打印 "  第一次凑出 18 的是：" + 找到

打印 ""
打印 "══ 真实场景：在表里找一对数 ══"
定义 找凑数(表, 目标)
    遍历 甲 于 表 @搜索
        遍历 乙 于 表
            如果 甲 + 乙 == 目标
                返回 "[" + 甲 + ", " + 乙 + "]"
    返回 "没找到"

打印 "  [2, 7, 11, 15] 里凑 9  = " + 找凑数([2, 7, 11, 15], 9)
打印 "  [2, 7, 11, 15] 里凑 100 = " + 找凑数([2, 7, 11, 15], 100)

打印 ""
打印 "══ 标号写在 遍历 上也行 ══"
结果 = []
遍历 甲 于 [1, 2, 3] @大循环
    遍历 乙 于 [10, 20, 30]
        追加(结果, 甲 * 乙)
        如果 甲 * 乙 > 30
            跳出 大循环
打印 "  " + 结果

打印 ""
打印 "══ 对照：老写法（标志变量）══"
还在找 = 真
次数 = 0
只要 还在找
    次数 += 1
    内 = 0
    只要 还在找
        内 += 1
        如果 内 > 2
            还在找 = 假
            继续
        打印 "  老写法 第" + 次数 + "轮 第" + 内 + "圈"

打印 ""
打印 "══ 普通 跳出 还是只退一层 ══"
遍历 甲 于 [1, 2] @带标号的
    遍历 乙 于 [1, 2]
        跳出
    打印 "  这行会打印（因为普通跳出只退内层）"

# ★ 标号写错的话【跑之前】就会被拦下来（静态检查），
#   所以没法用 尝试/出错 包它 —— 那属于「编译期错误」。
#   单独跑就会看到：
#     「不存在的标号」这个标号在哪呢？现在的标号只有：扫全表（标号就是行尾的 @名字）
