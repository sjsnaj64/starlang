# ============================================================
# 星语 Step 7 演示（二）：钩子可以拔掉
# ============================================================
# 「插入」焊上去就下不来了；「钩子」随时能摘。
# 这是两者最本质的差别。

定义 干活(x)
{
    打印 "做工 " + x
}

定义 打卡(x)
{
    打印 "    [打卡] " + x
}

# ---------- ① 挂着的时候，每跑一次都打卡 ----------
注册 之前 干活 打卡
干活(1)

# ---------- ② 拔掉，就不打了 ----------
拔掉 之前 干活 打卡
干活(2)

# ---------- ③ 还能再挂回来 ----------
注册 之前 干活 打卡
干活(3)
拔掉 之前 干活 打卡

# ---------- ④ 真正有意思的地方：运行中随时改主意 ----------
# 这段逻辑用「插入」是写不出来的 —— 织入在跑之前就定死了，
# 而这里第 1 圈才挂、第 2 圈就摘。
计数 = 0
只要 计数 < 3
{
    如果 计数 == 1
    {
        注册 之前 干活 打卡
    }
    如果 计数 == 2
    {
        拔掉 之前 干活 打卡
    }
    干活(计数)
    计数 = 计数 + 1
}
