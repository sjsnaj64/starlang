# ============================================================
# 星语 Step 18 演示：默认参数
# ============================================================
# 以前想「这个参数可以不传」，只能写两个函数：
#
#     定义 排序(表)                     定义 排序按(表, 比较器)
#         返回 排序按(表, 默认排序)           …
#
# 现在一个就够：
#
#     定义 排序(表, 比较器 = 匿名(甲, 乙) { 返回 甲 < 乙 })
#
# ★ 星语的默认值是【每次调用重新算】的，不是定义时算一次就冻住。
#   这跟 Python 相反 —— Python 的 def f(x=[]) 会让所有调用共享同一个列表，
#   是出了名的坑。星语选了安全的那一边。
# ============================================================

载入 "标准库.star"

打印 "══ 基本用法 ══"

定义 问候(名字, 招呼 = "你好")
    返回 招呼 + "，" + 名字 + "！"

打印 "  " + 问候("小明")
打印 "  " + 问候("小红", "早上好")

定义 坐标(x, y = 0, z = 0)
    返回 "(" + x + ", " + y + ", " + z + ")"

打印 "  坐标(1)       = " + 坐标(1)
打印 "  坐标(1, 2)    = " + 坐标(1, 2)
打印 "  坐标(1, 2, 3) = " + 坐标(1, 2, 3)

打印 ""
打印 "══ 默认值用的是前面的参数 ══"
定义 长方形(宽, 高 = 宽)
    返回 宽 * 高

打印 "  长方形(4)    = " + 长方形(4)
打印 "  长方形(4, 3) = " + 长方形(4, 3)

打印 ""
打印 "══ 默认值是「每次调用重算」★ 重点 ══"
计数 = 0
定义 递增()
    计数 += 1
    返回 计数

定义 带编号(东西, 编号 = 递增())
    返回 东西 + "#" + 编号

打印 "  " + 带编号("苹果")
打印 "  " + 带编号("香蕉")
打印 "  " + 带编号("橙子", 99)
打印 "  " + 带编号("葡萄")
# ★ 如果默认值是「定义时算一次」，这里会一直是 #1。
#   星语每次调用重新算，所以编号能一路涨上去。

打印 ""
打印 "══ 标准库现在一个函数就够了 ══"
数们 = [5, 2, 9, 1, 7]
打印 "  不传比较器（默认升序）=" + 排序(数们)
打印 "  传个倒序的         =" + 排序(数们, 匿名(甲, 乙) { 返回 甲 > 乙 })
打印 "  按离 5 的远近       =" + 排序(数们, 匿名(甲, 乙) {
    返回 绝对值(甲 - 5) < 绝对值(乙 - 5)
})

打印 ""
打印 "══ 匿名函数也能有默认参数 ══"
加数 = 匿名(x, 加多少 = 10) { 返回 x + 加多少 }
打印 "  加数(5)    = " + 加数(5)
打印 "  加数(5, 1) = " + 加数(5, 1)

打印 ""
打印 "══ 参数个数不对时的报错 ══"
尝试
    坐标()
出错 错
    打印 "  " + 错

尝试
    坐标(1, 2, 3, 4)
出错 错
    打印 "  " + 错
