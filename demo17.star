# ============================================================
# 星语 Step 14 演示：跳出 / 继续 / 空
# ============================================================
# 在这之前，循环里想「提前结束」只能挂个标志变量：
#
#     还在跑 = 真
#     只要 还在跑 且 i < 100
#         如果 找到了
#             还在跑 = 假
#         否则
#             ...干活...
#
# 每加一层循环，就多一个标志、多一层 if。现在一个词搞定。
# ============================================================

# ---------- ① 继续：跳过这一圈剩下的部分 ----------
打印 "① 继续"
i = 0
只要 i < 6
    i = i + 1
    如果 i == 3
        打印 "  第三个，跳过"
        继续
    打印 "  第 " + i + " 圈"

# ---------- ② 跳出：直接结束整个循环 ----------
打印 ""
打印 "② 跳出：找第一个能被 7 整除的数"
n = 1
只要 真
    如果 n % 7 == 0
        跳出
    n = n + 1
打印 "  找到了 " + n

# ---------- ③ 跳出只退一层，不是全退 ----------
打印 ""
打印 "③ 嵌套：内层跳出不影响外层"
i = 0
只要 i < 3
    i = i + 1
    j = 0
    只要 真
        j = j + 1
        如果 j > i
            跳出
        打印 "  " + i + " 乘 " + j

# ---------- ④ 跳出能穿过 尝试/出错 ----------
# 编译器版用的是 Python 的 break，天生穿得过去；
# 解释器版是抛异常，一不小心就会被「出错」当成普通错误吃掉 —— 得专门拦住。
打印 ""
打印 "④ 跳出穿过 尝试"
i = 0
只要 i < 5
    i = i + 1
    尝试
        如果 i == 3
            跳出
        打印 "  干活中 " + i
    出错 错
        打印 "  这本不该出现：" + 错
打印 "  循环结束，i = " + i

# ---------- ⑤ 空 ----------
打印 ""
打印 "⑤ 空值"
什么也没有 = 空
打印 "  类型是 " + 类型(什么也没有)
如果 什么也没有 == 空
    打印 "  跟 空 相等"
打印 "  当条件用时是 " + (非 什么也没有)

# ---------- ⑥ 空 在函数里当「没找到」的返回值 ----------
打印 ""
打印 "⑥ 用 空 表示没找到"

定义 找一下(表, 目标)
    k = 0
    只要 k < 长度(表)
        如果 表[k] == 目标
            返回 k
        k = k + 1
    返回 空

位置 = 找一下(["甲", "乙", "丙"], "乙")
如果 位置 == 空
    打印 "  没找到"
否则
    打印 "  乙 在第 " + 位置 + " 个"

位置 = 找一下(["甲", "乙", "丙"], "丁")
如果 位置 == 空
    打印 "  丁 没找到"
否则
    打印 "  丁 在第 " + 位置 + " 个"
