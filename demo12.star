# ============================================================
# 星语 Step 11 演示：用星语写一个完整的计算器
#                    —— 这是「自举」的第一小步
# ============================================================
# 流水线（跟 starlang.py 里一模一样）：
#
#   源码文本  "1 + 2 * 3"
#        │  ① 词法 切词()    ┐
#        ▼                    │  这三步
#   词表  ["1","+","2","*","3"]│  全部是
#        │  ② 语法 解析式()  │  用星语
#        ▼                    │  自己写的
#   语法树 ["+", 数1, ["*", 数2, 数3]]
#        │  ③ 求值 求值()
#        ▼
#      7

# ---------- ① 词法分析 ----------
定义 切词(源码)
{
    词们 = []
    当前 = ""
    字符表 = 字符们(源码)
    序 = 0
    只要 序 < 长度(字符表)
    {
        c = 字符表[序]
        如果 含有("+-*/() ", c)
        {
            如果 长度(当前) > 0
            {
                追加(词们, 当前)
                当前 = ""
            }
            如果 c != " "
            {
                追加(词们, c)
            }
        }
        否则
        {
            当前 = 当前 + c
        }
        序 = 序 + 1
    }
    如果 长度(当前) > 0
    {
        追加(词们, 当前)
    }
    返回 词们
}

# ---------- ② 语法分析 ----------
# ★ 关键技巧：星语没有指针，函数里改局部变量也传不回去。
#   所以把「读到第几个词了」放进一个只有一格的列表里 ——
#   列表是共享的，改 `游标[0]` 就能让所有函数都看到最新位置。
游标 = [0]

定义 当前词(词们)
{
    如果 游标[0] >= 长度(词们)
    {
        返回 "到头了"
    }
    返回 词们[游标[0]]
}

定义 吃掉()
{
    游标[0] = 游标[0] + 1
}

# 解析式 := 解析项 (('+'|'-') 解析项)*      ← 优先级最低
定义 解析式(词们)
{
    左 = 解析项(词们)
    完成 = 假
    只要 非 完成
    {
        现在 = 当前词(词们)
        如果 现在 == "+"
        {
            吃掉()
            左 = ["+", 左, 解析项(词们)]
        }
        否则
        {
            如果 现在 == "-"
            {
                吃掉()
                左 = ["-", 左, 解析项(词们)]
            }
            否则
            {
                完成 = 真
            }
        }
    }
    返回 左
}

# 解析项 := 解析因子 (('*'|'/') 解析因子)*
定义 解析项(词们)
{
    左 = 解析因子(词们)
    完成 = 假
    只要 非 完成
    {
        现在 = 当前词(词们)
        如果 现在 == "*"
        {
            吃掉()
            左 = ["*", 左, 解析因子(词们)]
        }
        否则
        {
            如果 现在 == "/"
            {
                吃掉()
                左 = ["/", 左, 解析因子(词们)]
            }
            否则
            {
                完成 = 真
            }
        }
    }
    返回 左
}

# 解析因子 := '-' 解析因子 | '(' 解析式 ')' | 数字
定义 解析因子(词们)
{
    现在 = 当前词(词们)
    如果 现在 == "-"
    {
        吃掉()
        返回 ["负", 解析因子(词们)]
    }
    如果 现在 == "("
    {
        吃掉()
        里面 = 解析式(词们)
        如果 当前词(词们) == ")"
        {
            吃掉()
        }
        返回 里面
    }
    如果 现在 == "到头了"
    {
        返回 ["数", 0]
    }
    吃掉()
    返回 ["数", 转数字(现在)]
}

# 星语还没有「文本转数字」的内置函数，所以自己造一个。
定义 转数字(文本)
{
    标 = 字符们(文本)
    结果 = 0
    序 = 0
    负 = 假
    如果 长度(标) > 0
    {
        如果 标[0] == "-"
        {
            负 = 真
            序 = 1
        }
    }
    只要 序 < 长度(标)
    {
        结果 = 结果 * 10 + 数字值(标[序])
        序 = 序 + 1
    }
    如果 负
    {
        返回 0 - 结果
    }
    返回 结果
}

定义 数字值(c)
{
    键 = "0123456789"
    序 = 0
    只要 序 < 10
    {
        如果 取段(键, 序, 序 + 1) == c
        {
            返回 序
        }
        序 = 序 + 1
    }
    返回 0
}

# ---------- ③ 求值 ----------
定义 求值(节点)
{
    种类 = 节点[0]
    如果 种类 == "数"
    {
        返回 节点[1]
    }
    如果 种类 == "负"
    {
        返回 0 - 求值(节点[1])
    }
    左 = 求值(节点[1])
    右 = 求值(节点[2])
    如果 种类 == "+"
    {
        返回 左 + 右
    }
    如果 种类 == "-"
    {
        返回 左 - 右
    }
    如果 种类 == "*"
    {
        返回 左 * 右
    }
    如果 种类 == "/"
    {
        返回 左 / 右
    }
    返回 0
}

# ---------- ④ 串起来 ----------
定义 算一算(源码)
{
    游标[0] = 0
    词们 = 切词(源码)
    树 = 解析式(词们)
    打印 源码 + "  →  词 " + 排成(词们, " ") + "  →  树 " + 树
    返回 求值(树)
}

# ---------- ⑤ 验证 ----------
打印 "── 用星语算星语 ──"
打印 "结果 = " + 算一算("1 + 2 * 3")
打印 "结果 = " + 算一算("(1 + 2) * 3")
打印 "结果 = " + 算一算("10 - 4 - 3")
打印 "结果 = " + 算一算("-5 + 3")
打印 "结果 = " + 算一算("((2 + 3) * (4 - 1)) / 3")

打印 ""
打印 "── 为什么填 (1+2)*3 是 9 而 1+2*3 是 7 ──"
打印 "看两行的【树】就明白：乘号挂得低（树更深），就先算。"
