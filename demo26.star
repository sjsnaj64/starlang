# ============================================================
# 星语 Step 21 演示：方法调用   话.长度()
# ============================================================
# ★ 先说清楚这是什么东西：它【不是】面向对象，也没有命名空间。
#   它纯粹是语法糖：
#
#       话.取段(0, 2)     跟      取段(话, 0, 2)     一模一样
#
#   所以「方法名」就是「函数名」。内建函数能当方法用，你自己定义
#   的函数也能当方法用，标准库里的也能 —— 全都是同一个查找规则。
#
#   好处是：三个实现的求值逻辑一行都没改，不可能会分叉。
# ============================================================

载入 "标准库.star"

话 = "星语真有意思"

打印 "══ 文本 ══"
打印 "  原文     = " + 话
打印 "  长度     = " + 话.长度()
打印 "  取前两个 = " + 话.取段(0, 2)
打印 "  取后三个 = " + 话.取段(3, 6)
打印 "  反转     = " + 话.文反转()

打印 ""
打印 "══ 找东西 ══"
打印 "  有几个「意」 = " + 话.数数("意")
打印 "  开头是星吗   = " + 话.开头是("星")
打印 "  结尾是思吗   = " + 话.结尾是("思")
打印 "  含「真」吗   = " + 话.含有("真")

打印 ""
打印 "══ 切分 / 拼接 ══"
句子 = "苹果,香蕉,橙子"
零件 = 句子.切分(",")
打印 "  切分 = " + 零件
打印 "  再接回去 = " + 零件.排成(" + ")
打印 "  换掉逗号 = " + 句子.换成(",", "、")

打印 ""
打印 "══ 列表 ══"
数们 = [3, 1, 4]
# ★ 追加() 返回的是「表本身」，所以可以一路链下去
数们 = 数们.追加(1).追加(5)
打印 "  追加后 = " + 数们
打印 "  长度   = " + 数们.长度()
打印 "  排成串 = " + 数们.排成("-")
打印 "  有 4 吗 = " + 数们.含有(4)
打印 "  弹出   = " + 数们.弹出()
打印 "  现在的 = " + 数们

打印 ""
打印 "══ 字典 ══"
分数 = ["语文": 92, "数学": 88]
打印 "  键们 = " + 分数.键们()
打印 "  值们 = " + 分数.值们()
打印 "  数 = " + 分数.长度()
打印 "  有数学吗 = " + 分数.含有("数学")

打印 ""
打印 "══ ★ 链起来写 ══"
# 每一步的返回值继续 . 下去 —— 中间结果不用起名字
打印 "  " + "  前面有空格  ".去空白().文反转().文重复(2)
打印 "  " + 排序([5, 2, 9]).取段(0, 2).排成("、")
打印 "  " + "a,b,c".切分(",").长度()

打印 ""
打印 "══ 自己定义的函数也能当方法 ══"
定义 加感叹(文本)
    返回 文本 + "！"

定义 包起来(文本, 左, 右)
    返回 左 + 文本 + 右

打印 "  " + "你好".加感叹()
打印 "  " + "你好".包起来("[", "]")

打印 ""
打印 "══ 两种写法完全等价 ══"
打印 "  方法式：" + 话.取段(0, 2)
打印 "  函数式：" + 取段(话, 0, 2)

打印 ""
打印 "══ 小数点还是小数点 ══"
打印 "  3.14 = " + 3.14
打印 "  1.5 + 2.5 = " + (1.5 + 2.5)

打印 ""
打印 "══ 名字里没这个方法就报普通的未定义 ══"
尝试
    打印 话.不存在的方法()
出错 错
    打印 "  " + 错
