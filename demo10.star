# ============================================================
# 星语 Step 9 演示：列表 与 字典
# ============================================================
# 列表：  ["星尘", "小明"]        ← 按位置排的
# 字典：  ["数学": 90, "语文": 85] ← 按名字查的
#         ★ 字典也用方括号，因为花括号已经被语句块占了

# ---------- ① 列表基本操作 ----------
名单 = ["星尘", "小明"]
打印 名单
打印 长度(名单)

追加(名单, "小红")
打印 名单

打印 名单[0]
打印 名单[2]
打印 名单[长度(名单) - 1]        # 最后一个
打印 名单[0 - 1]                  # 负数从后面数

名单[1] = "小刚"
打印 名单

打印 弹出(名单)
打印 名单

# ---------- ② 字典基本操作 ----------
分数 = ["数学": 90, "语文": 85]
打印 分数
打印 分数["数学"]

分数["英语"] = 70
打印 分数
打印 键们(分数)
打印 值们(分数)

打印 含有(分数, "语文")
打印 含有(分数, "物理")

# ---------- ③ 遍历：列表靠下标，字典靠 键们 ----------
打印 "── 遍历列表 ──"
序 = 0
只要 序 < 长度(名单)
{
    打印 名单[序]
    序 = 序 + 1
}

打印 "── 遍历字典 ──"
科目 = 键们(分数)
序 = 0
只要 序 < 长度(科目)
{
    打印 科目[序] + " = " + 分数[科目[序]]
    序 = 序 + 1
}

# ---------- ④ 空列表 / 空字典 算「假」 ----------
空表 = []
如果 空表
{
    打印 "空列表是真"
}
否则
{
    打印 "空列表是假"
}

空典 = [:]
打印 空典

# ---------- ⑤ 嵌套：列表里放列表，列表里放字典 ----------
班级 = [
    ["名字": "星尘", "分数": 90],
    ["名字": "小明", "分数": 85]
]
打印 班级
打印 班级[0]["名字"]
打印 班级[1]["分数"]

# ---------- ⑥ 列表运算 ----------
打印 范围(5)
打印 2 * 范围(3)
打印 范围(2, 8, 2)
打印 名单 + ["新来的"]

# ---------- ⑦ 函数里用列表 ----------
定义 求和(数字们)
{
    合 = 0
    序 = 0
    只要 序 < 长度(数字们)
    {
        合 = 合 + 数字们[序]
        序 = 序 + 1
    }
    返回 合
}

打印 求和([1, 2, 3, 4, 5])

# ---------- ⑧ 宏也能收列表当参数 ----------
宏 逐个打印(列表)
{
    序 = 0
    只要 序 < 长度(列表)
    {
        打印 列表[序]
        序 = 序 + 1
    }
}

逐个打印(["A", "B", "C"])
