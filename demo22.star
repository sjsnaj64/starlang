# ============================================================
# 星语 Step 17 演示：复合赋值 += -= *= /= %=
# ============================================================
# 「计数器加一」大概是全世界写得最多的一条语句。
# 以前：
#     点 = 点 + 1
# 现在：
#     点 += 1
#
# 只是少几个字吗？—— 少的是【写错的机会】：
#     点 = 点 + 1   里「点」要写两遍，两遍写得不一致就静默出 bug。
#   而且 `点 = 值 + 1` 这种手误编译器根本看不出来。
# ============================================================

打印 "══ 基本用法 ══"
数 = 10
打印 "数 = " + 数
数 += 5
打印 "数 += 5  → " + 数
数 -= 3
打印 "数 -= 3  → " + 数
数 *= 4
打印 "数 *= 4  → " + 数
数 /= 8
打印 "数 /= 8  → " + 数
数 = 17
数 %= 5
打印 "数 = 17; 数 %= 5 → " + 数

打印 ""
打印 "══ 字符串也能 += ══"
话 = "喵"
话 += "喵"
话 += "喵"
打印 "话 = " + 话

打印 ""
打印 "══ 真实场景：累加器 ══"
成绩 = [88, 92, 79, 95, 61]
总分 = 0
点 = 0
只要 点 < 长度(成绩)
    总分 += 成绩[点]
    点 += 1
打印 "总分 " + 总分 + "，平均 " + (总分 / 长度(成绩))

# 星语有 `continue` 的话，`点 += 1` 必须在前面 —— 不然会漏掉计数
双数和 = 0
点 = 0
只要 点 < 长度(成绩)
    点 += 1
    分 = 成绩[点 - 1]
    如果 分 % 2 != 0 { 继续 }
    双数和 += 分
打印 "偶数分之和 " + 双数和

打印 ""
打印 "══ 跟别的特性配合 ══"
# 复合赋值 + 三元
评语 = ""
分 = 72
评语 += 如果 分 >= 90 则 "优秀" 否则 如果 分 >= 60 则 "及格" 否则 "补考"
打印 "72 分 → " + 评语

# 复合赋值 + 匿名函数：自己写个累加
定义 连加(表)
    和 = 0
    点 = 0
    只要 点 < 长度(表)
        和 += 表[点]
        点 += 1
    返回 和
打印 "连加 = " + 连加([1, 2, 3, 4, 5])

# 复合赋值 + 嵌套循环
共 = 0
甲 = 0
只要 甲 < 3
    甲 += 1
    乙 = 0
    只要 乙 < 甲
        乙 += 1
        共 += 甲 * 乙
打印 "嵌套累加 = " + 共
