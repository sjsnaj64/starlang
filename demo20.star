# ============================================================
# 星语 Step 17 演示：自定义比较器 + 一批新标准库函数
# ============================================================
# 有了匿名函数，「排序」才能真正活起来：
# 顺序不再写死在库里，而是由你当场递一个「谁该在前」的规矩进去。
# ============================================================

载入 "标准库.star"

数们 = [5, 2, 9, 1, 7]

打印 "══ 排序的三种活法 ══"
打印 "原表   = " + 数们
打印 "升序   = " + 排序(数们)
打印 "降序   = " + 倒序(数们)
# ★ 按「离 5 有多远」排 —— 这就是自定义规矩，库里不可能预先写完
打印 "离5最近 = " + 排序按(数们, 匿名(甲, 乙) { 返回 绝对值(甲 - 5) < 绝对值(乙 - 5) })

打印 ""
打印 "══ 按真实场景排：先比分数、分数一样比名字 ══"
学生们 = [
    ["名": "小明", "分": 85],
    ["名": "小红", "分": 92],
    ["名": "小刚", "分": 85],
    ["名": "小丽", "分": 78]
]

排好 = 排序按(学生们, 匿名(甲, 乙) {
    如果 甲["分"] == 乙["分"] {
        返回 甲["名"] < 乙["名"]
    }
    返回 甲["分"] > 乙["分"]
})

点 = 0
只要 点 < 长度(排好)
    打印 "  " + 排好[点]["名"] + "  " + 排好[点]["分"]
    点 = 点 + 1

打印 ""
打印 "══ 挑一个：最大值 / 最小值 / 最长的那句 ══"
打印 "最大   = " + 挑一个(数们, 匿名(甲, 乙) { 返回 甲 > 乙 })
打印 "最小   = " + 挑一个(数们, 匿名(甲, 乙) { 返回 甲 < 乙 })

句子们 = ["喵", "喵喵喵喵", "喵喵"]
打印 "最长   = " + 挑一个(句子们, 匿名(甲, 乙) { 返回 长度(甲) > 长度(乙) })

打印 ""
打印 "══ 判断表：任意 / 全部 / 计数 / 第一个满足 ══"
打印 "有双数吗   = " + 任意(数们, 匿名(x) { 返回 x % 2 == 0 })
打印 "全是双数吗 = " + 全部(数们, 匿名(x) { 返回 x % 2 == 0 })
打印 "双数几个   = " + 计数(数们, 匿名(x) { 返回 x % 2 == 0 })
打印 "第一个>4的 = " + 第一个满足(数们, 匿名(x) { 返回 x > 4 })
打印 "第一个>99的 = " + 第一个满足(数们, 匿名(x) { 返回 x > 99 })

打印 ""
打印 "══ 拉链：两张表配成对 ══"
名字们 = ["小明", "小红", "小刚"]
分数们 = [85, 92, 78, 100]
配好 = 拉链(名字们, 分数们)
打印 "配好 = " + 配好
# 多出来的 100 被丢掉了（长度按短的算）

点 = 0
只要 点 < 长度(配好)
    打印 "  " + 配好[点][0] + " 考了 " + 配好[点][1]
    点 = 点 + 1

打印 ""
打印 "══ 拼起来用：谁比平均分高 ══"
分 = [88, 92, 79, 95, 61, 100, 73]
均 = 平均(分)
打印 "平均 = " + 均
打印 "高于平均的 = " + 过滤(分, 匿名(x) { 返回 x > 均 })
打印 "高于平均的有 " + 计数(分, 匿名(x) { 返回 x > 均 }) + " 个"
