# ============================================================
# 星语 Step 17 演示：三元表达式
# ============================================================
# 以前想在表达式里塞个条件，只能拆成语句：
#
#     如果 分数 >= 60
#         标签 = "及格"
#     否则
#         标签 = "不及格"
#
# 明明只是「选一个值」，却写了五行。
# 现在一行：
#
#     标签 = 如果 分数 >= 60 则 "及格" 否则 "不及格"
# ============================================================

载入 "标准库.star"

分数们 = [95, 62, 58, 80, 47, 100]

打印 "══ 基本用法 ══"
点 = 0
只要 点 < 长度(分数们)
    分 = 分数们[点]
    评语 = 如果 分 >= 60 则 "及格" 否则 "不及格"
    打印 "  " + 分 + " → " + 评语
    点 = 点 + 1

打印 ""
打印 "══ 能当值用：直接塞进函数参数 ══"
# 以前这种写法要先把值算到变量里，现在直接传
打印 "最高分：" + 挑一个(分数们, 匿名(a, b) { 返回 如果 a > b 则 真 否则 假 })
打印 "最低分：" + 挑一个(分数们, 匿名(a, b) { 返回 如果 a < b 则 真 否则 假 })

打印 ""
打印 "══ 能嵌进字符串拼接 ══"
及格数 = 计数(分数们, 匿名(x) { 返回 x >= 60 })
打印 "共 " + 长度(分数们) + " 人，" + 及格数 + " 人及格"
打印 "及格率 " + 及格数 + "/" + 长度(分数们)
打印 (如果 及格数 == 长度(分数们) 则 "全员通过！" 否则 "还有 " + (长度(分数们) - 及格数) + " 人补考")

打印 ""
打印 "══ 嵌套：从右往左吃 ══"
定义 分档(分)
    返回 如果 分 >= 90 则 "优秀" 否则 如果 分 >= 80 则 "良好" 否则 如果 分 >= 60 则 "及格" 否则 "补考"

点 = 0
只要 点 < 长度(分数们)
    打印 "  " + 分数们[点] + " → " + 分档(分数们[点])
    点 = 点 + 1

打印 ""
打印 "══ 和别的特性撞在一起 ══"
# 三元 + 匿名 + 排序按：按「离及格线远近」排
距线最近 = 排序按(分数们, 匿名(甲, 乙) {
    差甲 = 绝对值(甲 - 60)
    差乙 = 绝对值(乙 - 60)
    返回 如果 差甲 < 差乙 则 真 否则 差甲 == 差乙
})
打印 "离 60 分最近到最远：" + 距线最近

# 三元 + 循环控制
点 = 0
只要 真
    如果 点 >= 长度(分数们) { 跳出 }
    打印 "  " + 分数们[点] + (如果 分数们[点] < 60 则 "  ← 这个要补考" 否则 "")
    点 = 点 + 1

# 三元 + 空值判断
定义 找名字(表格, 谁)
    点 = 0
    只要 点 < 长度(表格)
        人 = 表格[点]
        如果 人["名"] == 谁
            返回 人["分"]
        点 = 点 + 1
    返回 空

学生们 = [["名": "小明", "分": 85], ["名": "小红", "分": 92]]
打印 ""
查分 = 找名字(学生们, "小红")
打印 "小红的分数：" + (如果 查分 == 空 则 "查无此人" 否则 查分)
查分 = 找名字(学生们, "小刚")
打印 "小刚的分数：" + (如果 查分 == 空 则 "查无此人" 否则 查分)
