# ============================================================
# 星语 Step 12 演示：用星语跑星语（语句级自举）
# ============================================================
# 这个文件里的全部代码都是星语，它做的事是：
#
#     读进一段星语源码  →  切成词  →  建成语法树  →  自己解释执行
#
# 支持： 赋值 / 打印 / 如果·否则如果·否则 / 只要 / 定义函数 / 返回 / 块
#        算术 比较 逻辑(含短路) / 字符串 / 布尔 / 函数调用 / 递归
#        尝试·出错 / 列表·字典字面量与下标读写 / 注册·拔掉 运行期钩子
#        宏（宏定义 + 宏调用，含 { 语句块 } 实参被摊平）+ AST 替换器
#        宏卫生化（gensym：宏体局部变量改名，不和调用者撞）+ 参数可在赋值号左边
#
# 不支持（诚实说明）：
#   ★ 插入（编译期织入）—— 它发生在“跑之前”，本来就该在上层 starlang.py 做。
#     让解释器在运行时织入也能做，但那就不是同一件事了。
#   ★ 内置函数只放了 6 个（长度/追加/弹出/键们/值们/含有），且靠显式分派

# ---------- ① 词法 ----------
# 词长这样：["类": "数"|"文"|"名"|"符"|"换行"|"到头", "值": ...]
分隔符 = " \t\r\n\"#+-*/%()<>=,{}[]:"

定义 切词(源码)
{
    标 = 字符们(源码)
    词们 = []
    序 = 0
    总长 = 长度(标)
    只要 序 < 总长
    {
        c = 标[序]
        如果 c == " " 或 c == "\t" 或 c == "\r"
        {
            序 = 序 + 1
        }
        否则如果 c == "#"
        {
            只要 序 < 总长 且 标[序] != "\n"
            {
                序 = 序 + 1
            }
        }
        否则如果 c == "\n"
        {
            追加(词们, ["类": "换行", "值": ""])
            序 = 序 + 1
        }
        否则如果 c == "\""
        {
            序 = 序 + 1
            文 = ""
            只要 序 < 总长 且 标[序] != "\""
            {
                文 = 文 + 标[序]
                序 = 序 + 1
            }
            如果 序 < 总长
            {
                序 = 序 + 1
            }
            追加(词们, ["类": "文", "值": 文])
        }
        否则如果 含有("0123456789", c)
        {
            数 = ""
            只要 序 < 总长 且 含有("0123456789", 标[序])
            {
                数 = 数 + 标[序]
                序 = 序 + 1
            }
            追加(词们, ["类": "数", "值": 转数字(数)])
        }
        否则如果 含有("+-*/%()<>=,{}[]:", c)
        {
            双 = 取段(源码, 序, 序 + 2)
            如果 双 == "==" 或 双 == "!=" 或 双 == "<=" 或 双 == ">="
            {
                追加(词们, ["类": "符", "值": 双])
                序 = 序 + 2
            }
            否则
            {
                追加(词们, ["类": "符", "值": c])
                序 = 序 + 1
            }
        }
        否则
        {
            串 = ""
            只要 序 < 总长 且 非 含有(分隔符, 标[序])
            {
                串 = 串 + 标[序]
                序 = 序 + 1
            }
            如果 长度(串) == 0
            {
                串 = 标[序]
                序 = 序 + 1
            }
            追加(词们, ["类": "名", "值": 串])
        }
    }
    追加(词们, ["类": "到头", "值": ""])
    返回 词们
}

定义 转数字(文本)
{
    标 = 字符们(文本)
    结果 = 0
    序 = 0
    只要 序 < 长度(标)
    {
        结果 = 结果 * 10 + 数字值(标[序])
        序 = 序 + 1
    }
    返回 结果
}

定义 数字值(c)
{
    键 = "0123456789"
    序 = 0
    只要 序 < 10
    {
        如果 取段(键, 序, 序 + 1) == c
        {
            返回 序
        }
        序 = 序 + 1
    }
    返回 0
}

# ---------- ② 语法 ----------
游标 = [0]
# 宏名字表：名字 → [参数名...]
# ★ 解析期就得有它 —— 解析到「名字(」时，必须先知道这名字是不是宏，
#   才知道括号里该按【表达式】读，还是该按【语句块】读。
宏表 = [:]

定义 词(词们)
{
    返回 词们[游标[0]]
}

定义 词类(词们)
{
    返回 词(词们)["类"]
}

定义 词值(词们)
{
    返回 词(词们)["值"]
}

定义 前移()
{
    游标[0] = 游标[0] + 1
}

定义 是名(词们, 文字)
{
    返回 词类(词们) == "名" 且 词值(词们) == 文字
}

定义 是符(词们, 文字)
{
    返回 词类(词们) == "符" 且 词值(词们) == 文字
}

定义 吃掉换行(词们)
{
    只要 词类(词们) == "换行"
    {
        前移()
    }
}

定义 解析程序(词们)
{
    语句们 = []
    吃掉换行(词们)
    只要 词类(词们) != "到头"
    {
        追加(语句们, 解析语句(词们))
        吃掉换行(词们)
    }
    返回 语句们
}

定义 解析语句(词们)
{
    # ★ 宏调用必须查在最前面：宏名可能跟关键字撞名，
    #   而且「名字(」这个形状只有先查宏表才能定夺。
    如果 是宏调用起头(词们)
    {
        返回 解析宏调用(词们)
    }
    如果 是名(词们, "宏")
    {
        返回 解析宏定义(词们)
    }
    如果 是名(词们, "注册") 或 是名(词们, "拔掉")
    {
        返回 解析钩子语句(词们)
    }
    如果 是名(词们, "尝试")
    {
        返回 解析尝试(词们)
    }
    如果 是名(词们, "定义")
    {
        返回 解析定义(词们)
    }
    如果 是名(词们, "如果")
    {
        返回 解析如果(词们)
    }
    如果 是名(词们, "只要")
    {
        返回 解析只要(词们)
    }
    如果 是名(词们, "返回")
    {
        返回 解析返回(词们)
    }
    如果 是名(词们, "打印") 或 是名(词们, "print")
    {
        前移()
        返回 ["打印", 解析式(词们)]
    }
    如果 是符(词们, "{")
    {
        返回 解析块(词们)
    }
    左 = 解析式(词们)
    如果 是符(词们, "=")
    {
        前移()
        如果 类型(左) == "表" 且 左[0] == "名"
        {
            返回 ["赋值", 左[1], 解析式(词们)]
        }
        如果 类型(左) == "表" 且 左[0] == "下标"
        {
            返回 ["设下标", 左[1], 左[2], 解析式(词们)]
        }
    }
    返回 ["表达式", 左]
}

定义 解析块(词们)
{
    前移()
    语句们 = []
    吃掉换行(词们)
    只要 非 是符(词们, "}")
    {
        如果 词类(词们) == "到头"
        {
            返回 ["块", 语句们]
        }
        追加(语句们, 解析语句(词们))
        吃掉换行(词们)
    }
    前移()
    返回 ["块", 语句们]
}

定义 解析如果(词们)
{
    前移()
    条件 = 解析式(词们)
    吃掉换行(词们)
    真块 = 解析块(词们)
    假块 = []
    吃掉换行(词们)
    如果 是名(词们, "否则如果")
    {
        前移()
        假块 = 解析如果体(词们)
    }
    否则如果 是名(词们, "否则")
    {
        前移()
        吃掉换行(词们)
        假块 = 解析块(词们)
    }
    返回 ["如果", 条件, 真块, 假块]
}

定义 解析如果体(词们)
{
    条件 = 解析式(词们)
    吃掉换行(词们)
    真块 = 解析块(词们)
    假块 = []
    吃掉换行(词们)
    如果 是名(词们, "否则如果")
    {
        前移()
        假块 = 解析如果体(词们)
    }
    否则如果 是名(词们, "否则")
    {
        前移()
        吃掉换行(词们)
        假块 = 解析块(词们)
    }
    返回 ["如果", 条件, 真块, 假块]
}

定义 解析只要(词们)
{
    前移()
    条件 = 解析式(词们)
    吃掉换行(词们)
    体 = 解析块(词们)
    返回 ["只要", 条件, 体]
}

定义 解析返回(词们)
{
    前移()
    如果 词类(词们) == "换行" 或 词类(词们) == "到头"
    {
        返回 ["返回", ["数", 0]]
    }
    返回 ["返回", 解析式(词们)]
}

# 注册 之前/之后 目标 钩子   /   拔掉 之前/之后 目标 钩子
定义 解析钩子语句(词们)
{
    动作词 = 词值(词们)
    前移()
    时机词 = 词值(词们)
    前移()
    目标 = 词值(词们)
    前移()
    钩子 = 词值(词们)
    前移()
    时机 = 时机词
    如果 时机词 == "前"
    {
        时机 = "之前"
    }
    如果 时机词 == "后"
    {
        时机 = "之后"
    }
    返回 [动作词, 时机, 目标, 钩子]
}

# 宏 名字(参数, ...) { 展开体…… }
# ★ 只能在最外层写，而且要在第一次调用之前 —— 理由见 宏表 的注释。
定义 解析宏定义(词们)
{
    前移()
    名字 = 词值(词们)
    前移()
    如果 是符(词们, "(")
    {
        前移()
    }
    参数们 = []
    只要 非 是符(词们, ")") 且 词类(词们) != "到头"
    {
        如果 词类(词们) == "名"
        {
            追加(参数们, 词值(词们))
        }
        前移()
    }
    如果 是符(词们, ")")
    {
        前移()
    }
    吃掉换行(词们)
    体 = 解析块(词们)
    宏表[名字] = 参数们
    返回 ["宏定义", 名字, 参数们, 体]
}

# 这名字是不是「已经被 宏 声明过、后面直接跟 ( 」
定义 是宏调用起头(词们)
{
    如果 词类(词们) != "名"
    {
        返回 假
    }
    如果 非 含有(宏表, 词值(词们))
    {
        返回 假
    }
    下 = 游标[0] + 1
    如果 下 >= 长度(词们)
    {
        返回 假
    }
    下词 = 词们[下]
    返回 下词["类"] == "符" 且 下词["值"] == "("
}

定义 解析宏调用(词们)
{
    名字 = 词值(词们)
    参数名们 = 宏表[名字]
    前移()
    吃掉换行(词们)
    如果 是符(词们, "(")
    {
        前移()
    }
    吃掉换行(词们)
    实参们 = []
    只要 非 是符(词们, ")") 且 词类(词们) != "到头"
    {
        追加(实参们, 解析宏实参(词们))
        吃掉换行(词们)
        如果 是符(词们, ",")
        {
            前移()
            吃掉换行(词们)
        }
    }
    如果 是符(词们, ")")
    {
        前移()
    }
    # ★ 参数个数在这里就能查出来（比执行期早，报错位置更准），
    #   但真正的展开要等执行期 —— 因为宏体执行要看到调用者的环境。
    返回 ["宏调用", 名字, 实参们]
}

# 宏实参：要么一整个 { 语句块 }，要么一个表达式。
# ★ 这一行就是「宏」比函数能干更多事的地方 —— 函数收到的是值，
#   宏收到的是一整段还没求值的代码。
定义 解析宏实参(词们)
{
    如果 是符(词们, "{")
    {
        返回 解析块(词们)
    }
    返回 解析式(词们)
}

定义 解析尝试(词们)
{
    前移()
    吃掉换行(词们)
    试块 = 解析块(词们)
    错块 = ["块", []]
    错名 = "错误"
    吃掉换行(词们)
    如果 是名(词们, "出错")
    {
        前移()
        如果 词类(词们) == "名"
        {
            错名 = 词值(词们)
            前移()
        }
        吃掉换行(词们)
        错块 = 解析块(词们)
    }
    返回 ["尝试", 试块, 错名, 错块]
}

定义 解析定义(词们)
{
    前移()
    名字 = 词值(词们)
    前移()
    前移()
    参数们 = []
    只要 非 是符(词们, ")")
    {
        如果 词类(词们) == "名"
        {
            追加(参数们, 词值(词们))
        }
        前移()
    }
    前移()
    吃掉换行(词们)
    体 = 解析块(词们)
    返回 ["定义", 名字, 参数们, 体]
}

定义 解析式(词们)
{
    返回 解析或(词们)
}

定义 解析或(词们)
{
    左 = 解析且(词们)
    只要 是名(词们, "或")
    {
        前移()
        左 = ["二元", "或", 左, 解析且(词们)]
    }
    返回 左
}

定义 解析且(词们)
{
    左 = 解析比较(词们)
    只要 是名(词们, "且")
    {
        前移()
        左 = ["二元", "且", 左, 解析比较(词们)]
    }
    返回 左
}

定义 解析比较(词们)
{
    左 = 解析加减(词们)
    只要 词类(词们) == "符" 且 (词值(词们) == "==" 或 词值(词们) == "!=" 或 词值(词们) == "<" 或 词值(词们) == ">" 或 词值(词们) == "<=" 或 词值(词们) == ">=")
    {
        符号 = 词值(词们)
        前移()
        左 = ["二元", 符号, 左, 解析加减(词们)]
    }
    返回 左
}

定义 解析加减(词们)
{
    左 = 解析乘除(词们)
    只要 词类(词们) == "符" 且 (词值(词们) == "+" 或 词值(词们) == "-")
    {
        符号 = 词值(词们)
        前移()
        左 = ["二元", 符号, 左, 解析乘除(词们)]
    }
    返回 左
}

定义 解析乘除(词们)
{
    左 = 解析一元(词们)
    只要 词类(词们) == "符" 且 (词值(词们) == "*" 或 词值(词们) == "/" 或 词值(词们) == "%")
    {
        符号 = 词值(词们)
        前移()
        左 = ["二元", 符号, 左, 解析一元(词们)]
    }
    返回 左
}

定义 解析一元(词们)
{
    如果 词类(词们) == "符" 且 (词值(词们) == "-" 或 词值(词们) == "+")
    {
        符号 = 词值(词们)
        前移()
        返回 ["一元", 符号, 解析一元(词们)]
    }
    如果 是名(词们, "非")
    {
        前移()
        返回 ["一元", "非", 解析一元(词们)]
    }
    返回 解析调用(词们)
}

定义 解析调用(词们)
{
    节点 = 解析基本(词们)
    完成 = 假
    只要 非 完成
    {
        如果 是符(词们, "(")
        {
            前移()
            实参们 = []
            只要 非 是符(词们, ")")
            {
                追加(实参们, 解析式(词们))
                如果 是符(词们, ",")
                {
                    前移()
                }
            }
            前移()
            节点 = ["调用", 节点, 实参们]
        }
        否则如果 是符(词们, "[")
        {
            前移()
            下标 = 解析式(词们)
            如果 是符(词们, "]")
            {
                前移()
            }
            节点 = ["下标", 节点, 下标]
        }
        否则
        {
            完成 = 真
        }
    }
    返回 节点
}

定义 解析基本(词们)
{
    类 = 词类(词们)
    如果 类 == "数"
    {
        值 = 词值(词们)
        前移()
        返回 ["数", 值]
    }
    如果 类 == "文"
    {
        值 = 词值(词们)
        前移()
        返回 ["文", 值]
    }
    如果 是符(词们, "(")
    {
        前移()
        里面 = 解析式(词们)
        前移()
        返回 里面
    }
    如果 是符(词们, "[")
    {
        返回 解析集合(词们)
    }
    如果 类 == "名"
    {
        串 = 词值(词们)
        前移()
        如果 串 == "真"
        {
            返回 ["布尔", 真]
        }
        如果 串 == "假"
        {
            返回 ["布尔", 假]
        }
        返回 ["名", 串]
    }
    前移()
    返回 ["数", 0]
}

# 集合字面量：  [1, 2] 是列表 / ["a": 1] 是字典 / [: ] 是空字典
定义 解析集合(词们)
{
    前移()
    如果 是符(词们, "]")
    {
        前移()
        返回 ["表", []]
    }
    如果 是符(词们, ":")
    {
        前移()
        如果 是符(词们, "]")
        {
            前移()
        }
        返回 ["典", []]
    }
    首 = 解析式(词们)
    如果 是符(词们, ":")
    {
        前移()
        对们 = [[首, 解析式(词们)]]
        只要 是符(词们, ",")
        {
            前移()
            如果 是符(词们, "]")
            {
                返回 收字典(对们, 词们)
            }
            键 = 解析式(词们)
            如果 是符(词们, ":")
            {
                前移()
            }
            追加(对们, [键, 解析式(词们)])
        }
        返回 收字典(对们, 词们)
    }
    项们 = [首]
    只要 是符(词们, ",")
    {
        前移()
        如果 是符(词们, "]")
        {
            返回 收列表(项们, 词们)
        }
        追加(项们, 解析式(词们))
    }
    返回 收列表(项们, 词们)
}

定义 收列表(项们, 词们)
{
    如果 是符(词们, "]")
    {
        前移()
    }
    返回 ["表", 项们]
}

定义 收字典(对们, 词们)
{
    如果 是符(词们, "]")
    {
        前移()
    }
    返回 ["典", 对们]
}

# ---------- ③ 解释执行 ----------
# 环境长这样：["环境", 变量字典, 爸爸环境]
# 状态长这样：["正常"|"返回", 返回值]  ← 星语没有异常，只能靠这个盒子传递「返回」
状态 = ["正常", 0]
# 运行期钩子表：函数名 → ["之前": [函数值...], "之后": [函数值...]]
# ★ 存的是【函数值】而不是函数名 —— 因为 调用函数 拿不到调用者的环境，
#   光有名字没法子将这个函数找出来。
钩子表 = [:]
# 宏的【体】要等执行期才登记（宏表只存了参数名，供语法用）。
# 名字 → [参数名们, 体语句们]
宏定义表 = [:]
宏深度 = [0]              # 用表装，因为要在函数里改
宏错 = [""]              # 替换阶段的错误消息盒子
紧字号 = [0]             # 卫生化的编号：宏体局部名 → 名字#1、名字#2……
最大宏深 = 200

定义 是块(x)
{
    返回 类型(x) == "表" 且 长度(x) > 0 且 x[0] == "块"
}

# ★ 星语没有「抛错」，所以替换阶段发现的错先记到盒子里，
#   由 宏调用 那一侧统一报出来 —— 不能静默吞掉。
定义 报宏错(消息)
{
    如果 宏错[0] == ""
    {
        宏错[0] = 消息
    }
    返回 0
}

# ★★ 把 AST 里的参数名换成实参 AST。
#    只换【名字】，不求值 —— 这就是宏和函数的根本差别。
定义 换(节点, 替换表)
{
    如果 类型(节点) != "表"
    {
        返回 节点
    }
    # 变量节点 ["名", x] 命中参数 → 整颗换成实参 AST
    如果 长度(节点) == 2 且 节点[0] == "名" 且 含有(替换表, 节点[1])
    {
        实 = 替换表[节点[1]]
        如果 是块(实)
        {
            报宏错("宏参数「" + 节点[1] + "」传进来的是 { 语句块 }，但宏体这里拿它当表达式用了 —— 块只能独占地放在语句位置")
        }
        返回 实
    }
    # ★ 赋值号【左边】也可能是宏参数（“交换”这类宏全靠它）。
    #   注意赋值语句的左边存的是裸字符串，不是 ["名", 名字]，
    #   所以上面那条分支抓不到它，得单独认一次。
    如果 长度(节点) == 3 且 节点[0] == "赋值" 且 含有(替换表, 节点[1])
    {
        实 = 替换表[节点[1]]
        如果 非 (类型(实) == "表" 且 长度(实) == 2 且 实[0] == "名")
        {
            报宏错("宏参数「" + 节点[1] + "」被放在了赋值号左边，那里只能传一个【变量名】进来")
            返回 节点
        }
        返回 ["赋值", 实[1], 换(节点[2], 替换表)]
    }
    # 块节点走「语句表」那条路 —— 否则 `如果 条件 { 动作 }` 里
    # 那个 `动作` 会被当成表达式处理，块参数就摊不平了。
    如果 长度(节点) > 0 且 节点[0] == "块"
    {
        返回 ["块", 换语句表(节点[1], 替换表)]
    }
    结果 = []
    序 = 0
    只要 序 < 长度(节点)
    {
        追加(结果, 换(节点[序], 替换表))
        序 = 序 + 1
    }
    返回 结果
}

# ★ 块参数在【单独占一条语句】时要被摊平（splice）进去，
#   而不是嵌成一个块 —— 这样宏展开才真的像「把代码倒进来」。
定义 换语句表(语句表, 替换表)
{
    结果 = []
    序 = 0
    只要 序 < 长度(语句表)
    {
        句 = 语句表[序]
        摊平了 = 假
        如果 长度(句) == 2 且 句[0] == "表达式" 且 类型(句[1]) == "表" 且 长度(句[1]) == 2 且 句[1][0] == "名" 且 含有(替换表, 句[1][1])
        {
            实 = 替换表[句[1][1]]
            如果 是块(实)
            {
                内语句们 = 换语句表(实[1], 替换表)
                内序 = 0
                只要 内序 < 长度(内语句们)
                {
                    追加(结果, 内语句们[内序])
                    内序 = 内序 + 1
                }
            }
            否则
            {
                追加(结果, ["表达式", 实])
            }
            摊平了 = 真
        }
        如果 非 摊平了
        {
            追加(结果, 换(句, 替换表))
        }
        序 = 序 + 1
    }
    返回 结果
}

# ════════════ 宏卫生化（Hygiene）════════════
# 不卫生的宏：宏体里随手起的「临时」「和」「序」，展开时会跟调用者的
# 同名变量撞在一起 —— 撞了就悄悄算错，一句提示都没有。
# 治法叫 gensym：宏体【自己声明】的局部变量，展开时统统换成唯一名字。
#
# ★ 只做一半，而且是故意的：
#     宏体自己声明的名字 → 改名隔离
#     宏体里的自由变量   → 仍然看调用者的环境（这是宏之所以为宏的地方）

# 找出这段宏体自己【声明】了哪些名字。
# 星语没有集合类型，就拿字典当集合用：名字 → 真。传进去就地改。
定义 收集局部绑定(语句们, 结果)
{
    序 = 0
    只要 序 < 长度(语句们)
    {
        句 = 语句们[序]
        如果 类型(句) == "表" 且 长度(句) > 0
        {
            类 = 句[0]
            如果 类 == "赋值"
            {
                结果[句[1]] = 真
            }
            否则如果 类 == "定义"
            {
                结果[句[1]] = 真
                收集局部绑定(句[3][1], 结果)
            }
            否则如果 类 == "尝试"
            {
                结果[句[2]] = 真
                收集局部绑定(句[1][1], 结果)
                收集局部绑定(句[3][1], 结果)
            }
            否则如果 类 == "块"
            {
                收集局部绑定(句[1], 结果)
            }
            否则如果 类 == "如果"
            {
                收集局部绑定(句[2][1], 结果)
                如果 长度(句[3]) > 0
                {
                    如果 句[3][0] == "如果"
                    {
                        收集局部绑定([句[3]], 结果)
                    }
                    否则
                    {
                        收集局部绑定(句[3][1], 结果)
                    }
                }
            }
            否则如果 类 == "只要"
            {
                收集局部绑定(句[2][1], 结果)
            }
        }
        序 = 序 + 1
    }
    返回 结果
}

# 把 AST 里出现的【名字】按表换掉。
# ★ 跟 换() 的区别：换() 是拿整颗子 AST 顶掉参数节点（形状会变）；
#   重命名 只改名字字符串，形状一点都不动。
定义 重命名(节点, 改名表)
{
    如果 类型(节点) != "表"
    {
        返回 节点
    }
    如果 长度(节点) == 0
    {
        返回 节点
    }
    类 = 节点[0]
    如果 长度(节点) == 2 且 类 == "名"
    {
        如果 含有(改名表, 节点[1])
        {
            返回 ["名", 改名表[节点[1]]]
        }
        返回 节点
    }
    如果 类 == "块"
    {
        新语句们 = []
        序 = 0
        只要 序 < 长度(节点[1])
        {
            追加(新语句们, 重命名(节点[1][序], 改名表))
            序 = 序 + 1
        }
        返回 ["块", 新语句们]
    }
    如果 类 == "赋值"
    {
        左 = 节点[1]
        如果 含有(改名表, 左)
        {
            左 = 改名表[左]
        }
        返回 ["赋值", 左, 重命名(节点[2], 改名表)]
    }
    如果 类 == "定义"
    {
        函数名 = 节点[1]
        如果 含有(改名表, 函数名)
        {
            函数名 = 改名表[函数名]
        }
        新参数们 = []
        序 = 0
        只要 序 < 长度(节点[2])
        {
            参 = 节点[2][序]
            如果 含有(改名表, 参)
            {
                参 = 改名表[参]
            }
            追加(新参数们, 参)
            序 = 序 + 1
        }
        返回 ["定义", 函数名, 新参数们, 重命名(节点[3], 改名表)]
    }
    如果 类 == "尝试"
    {
        错名 = 节点[2]
        如果 含有(改名表, 错名)
        {
            错名 = 改名表[错名]
        }
        返回 ["尝试", 重命名(节点[1], 改名表), 错名, 重命名(节点[3], 改名表)]
    }
    如果 类 == "注册" 或 类 == "拔掉"
    {
        目标 = 节点[2]
        钩子 = 节点[3]
        如果 含有(改名表, 目标)
        {
            目标 = 改名表[目标]
        }
        如果 含有(改名表, 钩子)
        {
            钩子 = 改名表[钩子]
        }
        返回 [类, 节点[1], 目标, 钩子]
    }
    新节点 = []
    序 = 0
    只要 序 < 长度(节点)
    {
        追加(新节点, 重命名(节点[序], 改名表))
        序 = 序 + 1
    }
    返回 新节点
}

定义 新环境(爸爸)
{
    返回 ["环境", [:], 爸爸]
}

定义 是环境(x)
{
    返回 类型(x) == "表" 且 x[0] == "环境"
}

定义 找变量(环境, 名字)
{
    现在 = 环境
    只要 是环境(现在)
    {
        如果 含有(现在[1], 名字)
        {
            返回 现在[1][名字]
        }
        现在 = 现在[2]
    }
    返回 ["未定义", 名字]
}

定义 定变量(环境, 名字, 值)
{
    环境[1][名字] = 值
    返回 0
}

定义 设变量(环境, 名字, 值)
{
    现在 = 环境
    只要 是环境(现在)
    {
        如果 含有(现在[1], 名字)
        {
            现在[1][名字] = 值
            返回 0
        }
        现在 = 现在[2]
    }
    环境[1][名字] = 值
    返回 0
}

定义 真值(值)
{
    类 = 类型(值)
    如果 类 == "布"
    {
        返回 值
    }
    如果 类 == "数"
    {
        返回 值 != 0
    }
    如果 类 == "文"
    {
        返回 长度(值) > 0
    }
    如果 类 == "表"
    {
        返回 长度(值) > 0
    }
    如果 类 == "典"
    {
        返回 长度(值) > 0
    }
    返回 真
}

定义 求值(节点, 环境)
{
    类 = 节点[0]
    如果 类 == "数" 或 类 == "文" 或 类 == "布尔"
    {
        返回 节点[1]
    }
    如果 类 == "名"
    {
        返回 找变量(环境, 节点[1])
    }
    如果 类 == "表"
    {
        项们 = []
        序 = 0
        只要 序 < 长度(节点[1])
        {
            追加(项们, 求值(节点[1][序], 环境))
            序 = 序 + 1
        }
        返回 项们
    }
    如果 类 == "典"
    {
        典 = [:]
        对们 = 节点[1]
        序 = 0
        只要 序 < 长度(对们)
        {
            键 = 求值(对们[序][0], 环境)
            典[键] = 求值(对们[序][1], 环境)
            序 = 序 + 1
        }
        返回 典
    }
    如果 类 == "下标"
    {
        容器 = 求值(节点[1], 环境)
        返回 容器[求值(节点[2], 环境)]
    }
    如果 类 == "一元"
    {
        值 = 求值(节点[2], 环境)
        如果 节点[1] == "-"
        {
            返回 0 - 值
        }
        如果 节点[1] == "非"
        {
            返回 非 真值(值)
        }
        返回 值
    }
    如果 类 == "二元"
    {
        符号 = 节点[1]
        如果 符号 == "且"
        {
            如果 非 真值(求值(节点[2], 环境))
            {
                返回 假
            }
            返回 真值(求值(节点[3], 环境))
        }
        如果 符号 == "或"
        {
            如果 真值(求值(节点[2], 环境))
            {
                返回 真
            }
            返回 真值(求值(节点[3], 环境))
        }
        左 = 求值(节点[2], 环境)
        右 = 求值(节点[3], 环境)
        如果 符号 == "+"
        {
            返回 左 + 右
        }
        如果 符号 == "-"
        {
            返回 左 - 右
        }
        如果 符号 == "*"
        {
            返回 左 * 右
        }
        如果 符号 == "/"
        {
            返回 左 / 右
        }
        如果 符号 == "%"
        {
            返回 左 % 右
        }
        如果 符号 == "=="
        {
            返回 左 == 右
        }
        如果 符号 == "!="
        {
            返回 左 != 右
        }
        如果 符号 == "<"
        {
            返回 左 < 右
        }
        如果 符号 == ">"
        {
            返回 左 > 右
        }
        如果 符号 == "<="
        {
            返回 左 <= 右
        }
        返回 左 >= 右
    }
    如果 类 == "调用"
    {
        函数值 = 求值(节点[1], 环境)
        实参们 = []
        序 = 0
        只要 序 < 长度(节点[2])
        {
            追加(实参们, 求值(节点[2][序], 环境))
            序 = 序 + 1
        }
        返回 调用函数(函数值, 实参们)
    }
    返回 0
}

定义 调内置(名字, 实参们)
{
    如果 名字 == "长度"
    {
        返回 长度(实参们[0])
    }
    如果 名字 == "追加"
    {
        返回 追加(实参们[0], 实参们[1])
    }
    如果 名字 == "弹出"
    {
        返回 弹出(实参们[0])
    }
    如果 名字 == "键们"
    {
        返回 键们(实参们[0])
    }
    如果 名字 == "值们"
    {
        返回 值们(实参们[0])
    }
    如果 名字 == "含有"
    {
        返回 含有(实参们[0], 实参们[1])
    }
    返回 0
}

# 真正跑一个星语函数。★ 它【不看钩子表】——
# 正因为如此，钩子自己不会再被套一层，不会无缘无故递归。
定义 直接调用(函数值, 实参们)
{
    子环境 = 新环境(函数值[4])
    参数们 = 函数值[2]
    序 = 0
    只要 序 < 长度(参数们)
    {
        如果 序 < 长度(实参们)
        {
            定变量(子环境, 参数们[序], 实参们[序])
        }
        否则
        {
            定变量(子环境, 参数们[序], 0)
        }
        序 = 序 + 1
    }
    旧状态 = [状态[0], 状态[1]]
    状态[0] = "正常"
    执行块(函数值[3], 子环境)
    值 = 0
    如果 状态[0] == "返回"
    {
        值 = 状态[1]
    }
    状态[0] = 旧状态[0]
    状态[1] = 旧状态[1]
    返回 值
}

定义 取钩子(名字, 时机)
{
    如果 含有(钩子表, 名字)
    {
        返回 钩子表[名字][时机]
    }
    返回 []
}

定义 调用函数(函数值, 实参们)
{
    # ★ 内置函数：靠显式分派。
    #   为什么不能直接把 长度 这个值存进去再调？
    #   因为星语没有“拿一个值 + 一串实参 去调用”的语法（没有展开运算符），
    #   所以只能把名字记下来，到用时逐个 如果 比一下。
    如果 类型(函数值) == "表" 且 函数值[0] == "内置"
    {
        返回 调内置(函数值[1], 实参们)
    }
    如果 类型(函数值) != "表" 或 函数值[0] != "函数"
    {
        返回 0
    }

    # ★ 运行期钩子：之前 → 本体 → 之后
    名字 = 函数值[1]
    前 = 取钩子(名字, "之前")
    序 = 0
    只要 序 < 长度(前)
    {
        直接调用(前[序], 实参们)
        序 = 序 + 1
    }
    值 = 直接调用(函数值, 实参们)
    后 = 取钩子(名字, "之后")
    序 = 0
    只要 序 < 长度(后)
    {
        直接调用(后[序], [值])
        序 = 序 + 1
    }
    返回 值
}

定义 执行块(块, 环境)
{
    语句们 = 块[1]
    序 = 0
    只要 序 < 长度(语句们) 且 状态[0] == "正常"
    {
        执行(语句们[序], 环境)
        序 = 序 + 1
    }
    返回 0
}

# ★★ 宏调用：把实参的【代码】搬进宏体，然后在【调用者的环境】里跑。
#    注意最后那个 执行块(["块", 展开后], 环境) —— 用的是 环境，不是新环境。
#    这正是宏不是函数的地方：展开后的代码能直接看到调用者的变量。
定义 执行宏调用(语句, 环境)
{
    名字 = 语句[1]
    如果 非 含有(宏定义表, 名字)
    {
        打印 "【宏没定义】「" + 名字 + "」—— 宏定义要写在调用之前"
        返回 0
    }
    参数名们 = 宏定义表[名字][0]
    体语句们 = 宏定义表[名字][1]
    实参们 = 语句[2]
    如果 长度(实参们) != 长度(参数名们)
    {
        打印 "【宏参数不对】「" + 名字 + "」要 " + 长度(参数名们) + " 个参数，你给了 " + 长度(实参们) + " 个"
        返回 0
    }
    如果 宏深度[0] >= 最大宏深
    {
        打印 "【宏套太深】超过 " + 最大宏深 + " 层 —— 是不是宏体里又调了自己？"
        返回 0
    }
    替换表 = [:]
    序 = 0
    只要 序 < 长度(参数名们)
    {
        替换表[参数名们[序]] = 实参们[序]
        序 = 序 + 1
    }

    # ---- ★ 卫生化：先给宏体自己的局部变量改名 ----
    # 顺序很重要：必须先改名、再做参数替换。
    # 反过来的话，实参里恰好叫「临时」的变量会被一起改掉，那就错了。
    局部表 = [:]
    收集局部绑定(体语句们, 局部表)
    局部名们 = 键们(局部表)
    要改的 = []
    序 = 0
    只要 序 < 长度(局部名们)
    {
        是参数 = 假
        内 = 0
        只要 内 < 长度(参数名们)
        {
            如果 参数名们[内] == 局部名们[序]
            {
                是参数 = 真
            }
            内 = 内 + 1
        }
        如果 非 是参数
        {
            追加(要改的, 局部名们[序])
        }
        序 = 序 + 1
    }
    如果 长度(要改的) > 0
    {
        紧字号[0] = 紧字号[0] + 1
        后缀 = "#" + 紧字号[0]
        改名表 = [:]
        序 = 0
        只要 序 < 长度(要改的)
        {
            改名表[要改的[序]] = 要改的[序] + 后缀
            序 = 序 + 1
        }
        新体 = []
        序 = 0
        只要 序 < 长度(体语句们)
        {
            追加(新体, 重命名(体语句们[序], 改名表))
            序 = 序 + 1
        }
        体语句们 = 新体
    }

    宏错[0] = ""
    展开后 = 换语句表(体语句们, 替换表)
    如果 宏错[0] != ""
    {
        打印 "【宏错】" + 宏错[0]
        宏错[0] = ""
        返回 0
    }
    宏深度[0] = 宏深度[0] + 1
    执行块(["块", 展开后], 环境)
    宏深度[0] = 宏深度[0] - 1
    返回 0
}

定义 执行(语句, 环境)
{
    类 = 语句[0]
    如果 类 == "打印"
    {
        打印 求值(语句[1], 环境)
    }
    否则如果 类 == "赋值"
    {
        设变量(环境, 语句[1], 求值(语句[2], 环境))
    }
    否则如果 类 == "设下标"
    {
        容器 = 求值(语句[1], 环境)
        容器[求值(语句[2], 环境)] = 求值(语句[3], 环境)
    }
    否则如果 类 == "表达式"
    {
        求值(语句[1], 环境)
    }
    否则如果 类 == "如果"
    {
        如果 真值(求值(语句[1], 环境))
        {
            执行块(语句[2], 环境)
        }
        否则
        {
            如果 长度(语句[3]) > 0
            {
                如果 语句[3][0] == "如果"
                {
                    执行(语句[3], 环境)
                }
                否则
                {
                    执行块(语句[3], 环境)
                }
            }
        }
    }
    否则如果 类 == "尝试"
    {
        尝试
        {
            执行块(语句[1], 环境)
        }
        出错 情报
        {
            子环境 = 新环境(环境)
            定变量(子环境, 语句[2], 情报)
            执行块(语句[3], 子环境)
        }
    }
    否则如果 类 == "只要"
    {
        圈数 = 0
        只要 真值(求值(语句[1], 环境)) 且 状态[0] == "正常"
        {
            执行块(语句[2], 环境)
            圈数 = 圈数 + 1
            如果 圈数 > 100000
            {
                状态[0] = "失控"
            }
        }
    }
    否则如果 类 == "块"
    {
        执行块(语句, 环境)
    }
    否则如果 类 == "定义"
    {
        定变量(环境, 语句[1], ["函数", 语句[1], 语句[2], 语句[3], 环境])
    }
    否则如果 类 == "宏定义"
    {
        宏定义表[语句[1]] = [语句[2], 语句[3][1]]
    }
    否则如果 类 == "宏调用"
    {
        执行宏调用(语句, 环境)
    }
    否则如果 类 == "注册"
    {
        名字 = 语句[2]
        如果 非 含有(钩子表, 名字)
        {
            钩子表[名字] = ["之前": [], "之后": []]
        }
        追加(钩子表[名字][语句[1]], 找变量(环境, 语句[3]))
    }
    否则如果 类 == "拔掉"
    {
        名字 = 语句[2]
        钩子名 = 语句[3]
        如果 非 含有(钩子表, 名字)
        {
            打印 "【拔不掉】「" + 名字 + "」上什么都没挂"
        }
        否则
        {
            列 = 钩子表[名字][语句[1]]
            剩下 = []
            序 = 0
            拔掉了 = 假
            只要 序 < 长度(列)
            {
                如果 列[序][1] == 钩子名
                {
                    拔掉了 = 真
                }
                否则
                {
                    追加(剩下, 列[序])
                }
                序 = 序 + 1
            }
            钩子表[名字][语句[1]] = 剩下
            如果 非 拔掉了
            {
                打印 "【拔不掉】「" + 名字 + "」的" + 语句[1] + "没挂着「" + 钩子名 + "」"
            }
        }
    }
    否则如果 类 == "返回"
    {
        状态[0] = "返回"
        状态[1] = 求值(语句[1], 环境)
    }
    返回 0
}

# ---------- ④ 驱动 ----------
定义 跑(源码)
{
    游标[0] = 0
    宏表 = [:]
    宏定义表 = [:]
    宏深度[0] = 0
    宏错[0] = ""
    紧字号[0] = 0
    词们 = 切词(源码)
    语句们 = 解析程序(词们)
    全局 = 新环境(0)
    钩子表 = [:]
    定变量(全局, "长度", ["内置", "长度"])
    定变量(全局, "追加", ["内置", "追加"])
    定变量(全局, "弹出", ["内置", "弹出"])
    定变量(全局, "键们", ["内置", "键们"])
    定变量(全局, "值们", ["内置", "值们"])
    定变量(全局, "含有", ["内置", "含有"])
    状态[0] = "正常"
    # ★★ 兜底只能放【最外层】。
    #    如果放在“每执行一条语句”那里，就会把被解释程序
    #    自己写的 尝试/出错 抢先吃接 —— 它的出错块永远轮不到执行。
    尝试
    {
        执行块(["块", 语句们], 全局)
    }
    出错 情报
    {
        打印 "【解释器兜住了】" + 情报
    }
}

# ============================================================
# ⑤ 验证：把星语源码当【数据】喂给星语
# ============================================================
打印 "── 1. 算术与赋值 ──"
跑("x = 1 + 2 * 3\n打印 x")

打印 "── 2. 只要循环 ──"
跑("合 = 0\n序 = 1\n只要 序 <= 5\n{\n合 = 合 + 序\n序 = 序 + 1\n}\n打印 合")

打印 "── 3. 定义函数 ──"
跑("定义 平方(n)\n{\n返回 n * n\n}\n打印 平方(7)")

打印 "── 4. 函数里用 返回 提前退出 ──"
跑("定义 最大(a, b)\n{\n如果 a > b\n{\n返回 a\n}\n否则\n{\n返回 b\n}\n}\n打印 最大(3, 9)")

打印 "── 5. 递归 ──"
跑("定义 阶乘(n)\n{\n如果 n <= 1\n{\n返回 1\n}\n返回 n * 阶乘(n - 1)\n}\n打印 阶乘(6)")

打印 "── 6. 字符串与逻辑 ──"
跑("名字 = \"星尘\"\n打印 \"你好，\" + 名字\n如果 1 < 2 且 3 < 4\n{\n打印 \"逻辑也对\"\n}")

打印 "── 7. 被解释的程序自己用 尝试/出错 ──"
跑("尝试\n{\n打印 1 / 0\n打印 \"这句不该出现\"\n}\n出错 错\n{\n打印 \"它自己抓住了：\" + 错\n}\n打印 \"出错块的后面还在跑\"")

打印 "── 8. 被解释的程序没兜 → 解释器兜住 ──"
跑("打印 \"第一句\"\n打印 1 / 0\n打印 \"这句不该出现\"")

打印 "── 9. 解释器崩完还能接着用 ──"
跑("打印 2 * 21")

打印 "── 10. 列表 ──"
跑("名单 = [\"星尘\", \"小明\"]\n打印 名单\n打印 长度(名单)\n追加(名单, \"小红\")\n打印 名单\n打印 名单[0]\n打印 名单[2]")

打印 "── 11. 字典 ──"
跑("分数 = [\"数学\": 90, \"语文\": 85]\n打印 分数\n打印 分数[\"数学\"]\n分数[\"英语\"] = 70\n打印 分数\n打印 键们(分数)")

打印 "── 12. 嵌套与下标写入 ──"
跑("表 = [[1, 2], [3, 4]]\n打印 表\n打印 表[1][0]\n表[0][1] = 99\n打印 表")

打印 "── 13. 空集合 ──"
跑("打印 []\n打印 [:]")

打印 "── 14. 运行期钩子 ──"
跑("定义 打招呼(名字)\n{\n打印 \"你好，\" + 名字\n}\n定义 记进门(名字)\n{\n打印 \"  [钩] 要来打招呼了：\" + 名字\n}\n注册 之前 打招呼 记进门\n打招呼(\"星尘\")")

打印 "── 15. 拔掉钩子 ──"
跑("定义 f(x)\n{\n打印 \"做工 \" + x\n}\n定义 打卡(x)\n{\n打印 \"  [打卡] \" + x\n}\n注册 之前 f 打卡\nf(1)\n拔掉 之前 f 打卡\nf(2)")

打印 "── 16. 之后钩子拿返回值 ──"
跑("定义 加一(x)\n{\n返回 x + 1\n}\n定义 报结果(值)\n{\n打印 \"  [钩] 算完了，结果=\" + 值\n}\n注册 之后 加一 报结果\n打印 加一(41)")

打印 "── 17. 宏：自己造一个「除非」 ──"
跑("宏 除非(条件, 动作)\n{\n如果 条件 == 0\n{\n动作\n}\n}\n就绪 = 0\n除非(就绪, {\n打印 \"还没就绪，等一下\"\n})\n就绪 = 1\n除非(就绪, {\n打印 \"这句不该出现\"\n})\n打印 \"完\"")

打印 "── 18. 宏：块参数被摊平三次 ──"
跑("宏 重复三次(做什么)\n{\n做什么\n做什么\n做什么\n}\n重复三次({\n打印 \"同一句话\"\n})")

打印 "── 19. 宏：看得到调用者的变量 ──"
跑("宏 报数(前缀)\n{\n打印 前缀 + 计数器\n}\n计数器 = 100\n报数(\"现在计数是 \")\n计数器 = 200\n报数(\"现在计数是 \")")

打印 "── 20. 宏：表达式实参原样搬（不求值）──"
跑("宏 打印两遍(东西)\n{\n打印 东西\n打印 东西\n}\n打印两遍(\"被打印了\" + \"两次\")")

打印 "── 21. 宏：块参数错当表达式用 → 报出来，不静默 ──"
跑("宏 坏(东西)\n{\n打印 东西\n}\n坏({\n打印 \"塞进来的块\"\n})")

打印 "── 22. 卫生化：宏体局部不踩调用者的变量 ──"
跑("宏 求和并报(n)\n{\n和 = 0\n序 = 0\n只要 序 < n\n{\n和 = 和 + 序\n序 = 序 + 1\n}\n打印 \"  宏内 和=\" + 和\n}\n和 = 777\n序 = 888\n求和并报(5)\n打印 \"  调用者的 和=\" + 和\n打印 \"  调用者的 序=\" + 序")

打印 "── 23. 卫生化：实参不被宏体捕获 ──"
跑("宏 执行(动作)\n{\n临时 = \"宏体自己造的\"\n打印 \"  宏内 临时=\" + 临时\n动作\n}\n临时 = \"调用者的\"\n执行({\n打印 \"  实参里看到 临时=\" + 临时\n})")

打印 "── 24. 卫生化：交换宏（参数在赋值号左边）──"
跑("宏 交换(a, b)\n{\n临时 = a\na = b\nb = 临时\n}\nx = 1\ny = 2\n交换(x, y)\n打印 \"  x=\" + x + \"  y=\" + y\nx = 10\n临时 = 20\n交换(x, 临时)\n打印 \"  x=\" + x + \"  临时=\" + 临时")

打印 "── 25. 卫生化：宏体里的函数不撞调用者的同名函数 ──"
跑("宏 跑一遍()\n{\n定义 帮手(x)\n{\n返回 x * 2\n}\n打印 \"  宏内 帮手(5)=\" + 帮手(5)\n}\n定义 帮手(x)\n{\n返回 \"我是调用者的帮手\"\n}\n跑一遍()\n打印 \"  调用者的 帮手(5)=\" + 帮手(5)")
