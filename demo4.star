# 星语 Step 4 演示：函数 / 参数 / 返回 / 闭包
# 运行:  python starlang.py demo4.star
# 透视:  python starlang.py --all demo4.star

# ---- 1. 最简单的函数 ----
定义 平方(x) {
    返回 x * x
}
print 平方(5)

# ---- 2. 多个参数 ----
定义 最大值(a, b) {
    if a > b {
        返回 a
    }
    返回 b
}
print 最大值(3, 9)

# ---- 3. 递归：阶乘 ----
定义 阶乘(n) {
    if n <= 1 {
        返回 1
    }
    返回 n * 阶乘(n - 1)
}
print 阶乘(5)
print 阶乘(10)

# ---- 4. 递归：斐波那契 ----
定义 斐波(n) {
    if n < 2 {
        返回 n
    }
    返回 斐波(n - 1) + 斐波(n - 2)
}
print 斐波(15)

# ---- 5. 没有「返回」的功能 → 返回「空」 ----
定义 喊一声() {
    print 42
}
print 喊一声()

# ---- 6. 闭包：函数记住了它出生时的环境 ----
定义 计数器() {
    次数 = 0
    定义 下一个() {
        次数 = 次数 + 1
        返回 次数
    }
    返回 下一个
}
c1 = 计数器()
c2 = 计数器()
print c1()
print c1()
print c1()
print c2()

# ---- 7. 作用域：参数不会污染外面 ----
x = 100
定义 加一(x) {
    x = x + 1
    返回 x
}
print 加一(1)
print x

# ---- 8. 函数也是值，可以当参数传 ----
定义 套用(f, v) {
    返回 f(v)
}
print 套用(平方, 6)

# ---- 9. 演示一下错误的用法（去掉注释试试）----
# 平方(1, 2)      ← 参数个数不对
# 返回 1          ← 返回写在函数外面
# 5(1)            ← 数字不是函数
