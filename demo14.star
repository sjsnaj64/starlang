# ============================================================
# 星语 Step 12 演示：错误处理
# ============================================================
#     尝试
#     {
#         可能出错的代码
#     }
#     出错 错误        ← 这个名字可以自己起，不写就叫「错误」
#     {
#         出错了才跑
#     }

# ---------- ① 除零 ----------
打印 "① 除零"
尝试
{
    打印 1 / 0
    打印 "这一行不会跑"
}
出错 坏消息
{
    打印 "抓到了：" + 坏消息
}

# ---------- ② 变量没定义 ----------
打印 "② 变量不存在"
尝试
{
    打印 从来没定义过的东西
}
出错
{
    打印 "抓到了：" + 错误
}

# ---------- ③ 下标越界 ----------
打印 "③ 下标越界"
尝试
{
    表 = [1, 2]
    打印 表[10]
}
出错 错
{
    打印 "抓到了：" + 错
}

# ---------- ④ 字典缺键 ----------
打印 "④ 字典缺键"
尝试
{
    分数 = ["数学": 90]
    打印 分数["物理"]
}
出错 错
{
    打印 "抓到了：" + 错
}

# ---------- ⑤ 参数个数不对 ----------
打印 "⑤ 参数个数不对"
定义 加一(x)
{
    返回 x + 1
}
尝试
{
    打印 加一(1, 2, 3)
}
出错 错
{
    打印 "抓到了：" + 错
}

# ---------- ⑥ ★★★ 最重要的一条：返回不能被吃掉 ----------
# 「返回」在星语内部是用异常实现的。
# 如果 catch 不特判，函数就再也正常返回不了 —— 这是这类实现最经典的坑。
打印 "⑥ 返回 不能被 catch 吃掉"
定义 试一试()
{
    尝试
    {
        返回 "正常返回的值"
    }
    出错
    {
        返回 "不该走到这里"
    }
}
打印 试一试()

# ---------- ⑦ 出错块里能读到外面的变量 ----------
# 因为出错块的新环境，爸爸就是【当前环境】
打印 "⑦ 出错块能看外面"
外面的数 = 100
尝试
{
    打印 1 / 0
}
出错
{
    打印 "外面 外面的数 = " + 外面的数
}

# ---------- ⑧ 没出错就走 出错块？不走 ----------
打印 "⑧ 没出错就不进出错块"
尝试
{
    打印 "一切正常"
}
出错
{
    打印 "这句不该出现"
}

# ---------- ⑨ 嵌套：里层兜不住，外层接着兜 ----------
打印 "⑨ 嵌套"
定义 深()
{
    尝试
    {
        打印 1 / 0
    }
    出错
    {
        打印 "里层不想管，往外扔"
        返回 深二()
    }
}

定义 深二()
{
    打印 2 / 0
}

尝试
{
    深()
}
出错 错
{
    打印 "外层兜住了：" + 错
}

# ---------- ⑩ 出错块本身又出错 ----------
打印 "⑩ 出错块自己也出错 → 交给更外层"
尝试
{
    尝试
    {
        打印 1 / 0
    }
    出错
    {
        打印 "我也炸了"
        打印 1 / 0
    }
}
出错 错
{
    打印 "最外层兜住了：" + 错
}

打印 "── 全部结束，程序没有中断 ──"
