# ============================================================
# 星语 Step 13 演示：用缩进代替大括号
# ============================================================
# 同一份代码，两种写法都认：
#
#     如果 条件 {          ← 大括号
#         打印 1
#     }
#
#     如果 条件             ← 缩进
#         打印 1
#
# ★ 为什么两套都留着，不把大括号干掉？
#   · 缩进写起来爽，但**粘贴/对齐一出错就默默改了意思**，那就太难查了
#   · 大括号丑一点，但边界写死了，怎么折腾都是那个意思
#   两种都留着，你按心情选 —— 同一份代码里混用也行。
#
# ★ 一个必须知道的规则：
#   只有【花括号外面】和【方/圆括号外面】的缩进才算块。
#   所以多行列表里的缩进不会被当成块（不然 ["a": 1] 这种写法全崩）。


# ------------------------------------------------------------
# ① 最普通的：如果 / 否则
# ------------------------------------------------------------
价格 = 100
如果 价格 > 50
    打印 "太贵了"
否则
    打印 "还行"


# ------------------------------------------------------------
# ② 函数
# ------------------------------------------------------------
定义 加税(元)
    返回 元 * 1.06

打印 加税(100)


# ------------------------------------------------------------
# ③ 循环
# ------------------------------------------------------------
序 = 1
只要 序 <= 3
    打印 "第 " + 序 + " 圈"
    序 = 序 + 1


# ------------------------------------------------------------
# ④ 嵌套：缩进一层套一层
# ------------------------------------------------------------
定义 判断(数)
    如果 数 > 0
        如果 数 % 2 == 0
            返回 "正偶数"
        否则
            返回 "正奇数"
    如果 数 == 0
        返回 "零"
    返回 "负数"

打印 判断(6)
打印 判断(7)
打印 判断(0)
打印 判断(-3)


# ------------------------------------------------------------
# ⑤ 尝试 / 出错
# ------------------------------------------------------------
尝试
    打印 1 / 0
出错 错
    打印 "抓住了：" + 错


# ------------------------------------------------------------
# ⑥ 混着来：缩进块里用大括号，大括号里用缩进
# ------------------------------------------------------------
如果 1 > 0
    如果 2 > 0 {
        打印 "缩进块里套大括号"
    }
    打印 "回到缩进块"

如果 3 > 0 {
    打印 "大括号里"
}
如果 4 > 0
    打印 "又回到缩进"


# ------------------------------------------------------------
# ⑦ 宏 + 缩进
# ------------------------------------------------------------
宏 除非(条件, 动作)
    如果 条件 == 0
        动作

就绪 = 0
除非(就绪, {
    打印 "还没就绪"
})
就绪 = 1
除非(就绪, {
    打印 "这句不该出现"
})


# ------------------------------------------------------------
# ⑧ 多行列表 —— 里面的缩进【不算块】
# ------------------------------------------------------------
班级 = [
    ["名字": "星尘", "分数": 90],
    ["名字": "小明", "分数": 85]
]
打印 班级[0]["名字"]
打印 长度(班级)


# ------------------------------------------------------------
# ⑨ 空行和注释行不影响缩进
# ------------------------------------------------------------
如果 真

    # 这行是注释，不算缩进层

    打印 "注释和空行都没有破坏块"

打印 "结束"
