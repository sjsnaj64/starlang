# ============================================================
# 星语 Step 6 演示：字符串字面量
# ============================================================

打印 "你好，星语"
打印 '单引号也行'
打印 "换行\n第二行"
打印 "制表A\tB"
打印 "里面有\"双引号\""
打印 "里面有#井号（不会被当注释）"

# ---- 存进变量 ----
星尘 = "星尘"
打印 星尘
打印 星尘 + "！" + 星尘
打印 1 + 2

# ---- 比较 ----
打印 "abc" == "abc"
打印 "1" == 1
打印 "a" < "b"

# ---- 真假：空串算假 ----
如果 "" { 打印 "空串是真" } 否则 { 打印 "空串是假" }
如果 "x" { 打印 "非空串是真" } 否则 { 打印 "非空串是假" }

# ---- 循环里拼字符串 ----
计数 = 0
只要 计数 < 3 {
    打印 "第" + 计数 + "轮"
    计数 = 计数 + 1
}

# ---- 插到函数里也能用字符串 ----
定义 打招呼(名字)
{
    打印 "开始"
    打印 名字
}

插入 打招呼 结尾
{
    打印 "结束"
}

打招呼("小明")
