{
  "如果": {
    "prefix": ["如果", "rg", "if"],
    "body": ["如果 ${1:条件}", "{", "\t$0", "}"],
    "description": "如果块"
  },
  "如果否则": {
    "prefix": ["如果否则", "rgyf"],
    "body": ["如果 ${1:条件}", "{", "\t${2}", "}", "否则", "{", "\t$0", "}"],
    "description": "如果 / 否则"
  },
  "只要": {
    "prefix": ["只要", "yz", "while"],
    "body": ["只要 ${1:条件}", "{", "\t$0", "}"],
    "description": "循环块"
  },
  "定义": {
    "prefix": ["定义", "dy", "fn"],
    "body": ["定义 ${1:名字}(${2:参数})", "{", "\t返回 ${3:值}", "}"],
    "description": "定义函数"
  },
  "打印": {
    "prefix": ["打印", "dy2", "print"],
    "body": ["打印 ${1:值}"],
    "description": "打印"
  },
  "尝试": {
    "prefix": ["尝试", "cs", "try"],
    "body": ["尝试", "{", "\t$1", "}", "出错 ${2:错}", "{", "\t打印 \"出错了：\" + ${2:错}", "}"],
    "description": "尝试 / 出错"
  },
  "宏": {
    "prefix": ["宏", "hong", "macro"],
    "body": ["宏 ${1:名字}(${2:参数})", "{", "\t$0", "}"],
    "description": "宏（自己造语法）"
  },
  "插入": {
    "prefix": ["插入", "cr", "insert"],
    "body": ["插入 ${1:函数名} ${2:开头}", "{", "\t$0", "}"],
    "description": "插入代码到函数里"
  },
  "注册": {
    "prefix": ["注册", "zc", "hook"],
    "body": ["注册 之前 ${1:函数} ${2:钩子}"],
    "description": "挂一个运行期钩子"
  },
  "列表": {
    "prefix": ["列表", "lb"],
    "body": ["${1:名字} = [${2}]"],
    "description": "列表字面量"
  },
  "字典": {
    "prefix": ["字典", "zd"],
    "body": ["${1:名字} = [\"${2:键}\": ${3:值}]"],
    "description": "字典字面量"
  },
  "遍历": {
    "prefix": ["遍历", "bl"],
    "body": [
      "${1:序} = 0",
      "只要 ${1:序} < 长度(${2:列表})",
      "{",
      "\t${3:打印} ${2:列表}[${1:序}]",
      "\t${1:序} = ${1:序} + 1",
      "}"
    ],
    "description": "按下标遍历列表"
  },
  "追加": {
    "prefix": ["追加", "zj"],
    "body": ["追加(${1:列表}, ${2:值})"],
    "description": "往列表里塞一个"
  }
}
