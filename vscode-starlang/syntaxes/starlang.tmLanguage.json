{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "星语",
  "scopeName": "source.starlang",
  "comment": "★ 这个文件是 生成语法.py 自动生成的，别手改。改词表请改 starlang.py",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#标号"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#方法"
    },
    {
      "include": "#变量"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#内置函数"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.number-sign.starlang",
          "match": "#.*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "entity.name.tag.starlang",
                  "match": "#@[\\p{L}\\p{N}_]+"
                }
              ]
            }
          }
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.starlang",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.starlang",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        }
      ]
    },
    "标号": {
      "patterns": [
        {
          "name": "entity.name.tag.starlang",
          "match": "@[\\p{L}\\p{N}_]+"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.starlang",
          "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.exception.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:catch|try|出事|出错|试试|尝试|错了)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.control.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:continue|break|while|then|loop|跳过这圈|退出循环|else|for|下一圈|逐个|跳出|如果|打断|遍历|要是|继续|in|只要|否则|循环|if|那么|假如|重复|对于|不然|于|若|当|则|在)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.elseif.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:elseif|不然如果|elif|否则如果|否则若)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "storage.type.function.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:function|lambda|return|匿名函数|func|小函数|def|lam|返回|回传|匿名|fn|函数|定义|交回)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "support.function.print.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:print|echo|打印|显示|输出|说)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.word.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:and|not|并且|或者|or|而且|且|非|或)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.macro.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:insert|macro|tail|head|插进去|塞进去|最前|末尾|标签|开始|最后|结尾|开头|标号|插入|宏)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.hook.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:unregister|register|unhook|before|after|hook|挂上|卸下|之前|注册|拔掉|之后|摘掉|前|后)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.language.boolean.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:nothing|什么都没有|false|true|null|nil|空值|假|空|真)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "变量": {
      "patterns": [
        {
          "begin": "(?<![\\p{L}\\p{N}_])(?:function|func|def|fn|函数|定义)(\\s+)([\\p{L}\\p{N}_]+)(\\s*)(\\()",
          "beginCaptures": {
            "0": {
              "patterns": [
                {
                  "include": "#关键字"
                }
              ]
            },
            "2": {
              "name": "entity.name.function.starlang"
            },
            "4": {
              "name": "punctuation.definition.parameters.begin.starlang"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "variable.parameter.starlang",
              "match": "[\\p{L}\\p{N}_]+"
            }
          ]
        },
        {
          "comment": "x = 值 —— 左边是新造的变量",
          "match": "^(\\s*)([\\p{L}\\p{N}_]+)(\\s*)=(?!=)",
          "captures": {
            "2": {
              "name": "variable.other.assignment.starlang"
            }
          }
        }
      ]
    },
    "内置函数": {
      "patterns": [
        {
          "name": "support.function.builtin.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:readline|replace|readall|values|append|exists|lines|range|split|chars|trunc|isnum|write|strip|slice|idiv|type|read|文件在吗|追加文件|push|keys|join|has|字符们|按行分|div|读一行|len|是数字|pop|读文件|写文件|int|读全部|去空白|含有|范围|换成|键们|排成|类型|整除|弹出|切分|追加|取整|取段|读檔|值们|长度)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "方法": {
      "patterns": [
        {
          "match": "(\\.)\\s*([\\p{L}\\p{N}_]+)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.starlang"
            },
            "2": {
              "name": "support.function.method.starlang"
            }
          }
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arithmetic.starlang",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.starlang",
          "match": "(?<!<|>|!)=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "<|>"
        },
        {
          "name": "punctuation.separator.starlang",
          "match": "[,\\[\\]{}():]"
        }
      ]
    }
  }
}
