{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "星语",
  "scopeName": "source.starlang",
  "comment": "★ 这个文件是 生成语法.py 自动生成的，别手改。改词表请改 starlang.py",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#标号"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#方法"
    },
    {
      "include": "#变量"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#内置函数"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.number-sign.starlang",
          "match": "#.*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "entity.name.tag.starlang",
                  "match": "#@[\\p{L}\\p{N}_]+"
                }
              ]
            }
          }
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.starlang",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.starlang",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        }
      ]
    },
    "标号": {
      "patterns": [
        {
          "name": "entity.name.tag.starlang",
          "match": "@[\\p{L}\\p{N}_]+"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.starlang",
          "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.exception.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:catch|try|尝试|试试|出错|出事|错了)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.control.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:continue|while|break|跳过这圈|else|退出循环|then|loop|下一圈|for|否则|不然|重复|那么|遍历|in|if|只要|假如|打断|跳出|继续|逐个|对于|循环|要是|如果|若|则|于|在|当)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.elseif.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:elseif|否则如果|不然如果|elif|否则若)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "storage.type.function.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:function|return|lambda|func|匿名函数|lam|小函数|def|函数|交回|返回|匿名|定义|回传|fn)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "support.function.print.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:print|echo|输出|显示|打印|说)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.word.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:and|not|并且|而且|或者|or|非|或|且)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.macro.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:insert|macro|head|tail|插进去|塞进去|末尾|最后|结尾|开始|插入|标号|标签|最前|开头|宏)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.hook.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:unregister|register|before|unhook|after|hook|挂上|注册|拔掉|摘掉|之后|之前|卸下|后|前)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.preprocess.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:载入|引入)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.language.boolean.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:nothing|什么都没有|false|true|null|nil|空值|空|假|真)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "变量": {
      "patterns": [
        {
          "begin": "(?<![\\p{L}\\p{N}_])(?:function|func|def|函数|定义|fn)(\\s+)([\\p{L}\\p{N}_]+)(\\s*)(\\()",
          "beginCaptures": {
            "0": {
              "patterns": [
                {
                  "include": "#关键字"
                }
              ]
            },
            "2": {
              "name": "entity.name.function.starlang"
            },
            "4": {
              "name": "punctuation.definition.parameters.begin.starlang"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "variable.parameter.starlang",
              "match": "[\\p{L}\\p{N}_]+"
            }
          ]
        },
        {
          "comment": "x = 值 —— 左边是新造的变量",
          "match": "^(\\s*)([\\p{L}\\p{N}_]+)(\\s*)=(?!=)",
          "captures": {
            "2": {
              "name": "variable.other.assignment.starlang"
            }
          }
        }
      ]
    },
    "内置函数": {
      "patterns": [
        {
          "name": "support.function.builtin.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:datetimenow|readline|strftime|readall|nowtime|replace|exists|delkey|values|append|mktime|当前日期时间|isnum|trunc|lines|today|slice|格式化时间|split|chars|range|round|write|strip|idiv|追加文件|join|keys|read|push|文件在吗|现在时刻|type|四舍五入|是数字|读全部|读文件|pop|时间戳|has|按行分|字符们|读一行|写文件|去空白|len|div|int|now|整除|切分|取段|取整|追加|排成|键们|弹出|值们|今天|长度|类型|读檔|删键|范围|换成|含有|现在)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "方法": {
      "patterns": [
        {
          "match": "(\\.)\\s*([\\p{L}\\p{N}_]+)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.starlang"
            },
            "2": {
              "name": "support.function.method.starlang"
            }
          }
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arithmetic.starlang",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.starlang",
          "match": "(?<!<|>|!)=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "<|>"
        },
        {
          "name": "punctuation.separator.starlang",
          "match": "[,\\[\\]{}():]"
        }
      ]
    }
  }
}
