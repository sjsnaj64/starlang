{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "星语",
  "scopeName": "source.starlang",
  "comment": "★ 这个文件是 生成语法.py 自动生成的，别手改。改词表请改 starlang.py",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#标号"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#方法"
    },
    {
      "include": "#变量"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#内置函数"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.number-sign.starlang",
          "match": "#.*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "entity.name.tag.starlang",
                  "match": "#@[\\p{L}\\p{N}_]+"
                }
              ]
            }
          }
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.starlang",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.starlang",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        }
      ]
    },
    "标号": {
      "patterns": [
        {
          "name": "entity.name.tag.starlang",
          "match": "@[\\p{L}\\p{N}_]+"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.starlang",
          "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.exception.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:catch|try|试试|尝试|出错|错了|出事)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.control.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:continue|break|while|跳过这圈|then|loop|退出循环|else|下一圈|for|只要|不然|遍历|否则|那么|in|逐个|如果|循环|继续|打断|要是|if|假如|重复|跳出|对于|则|在|若|当|于)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.elseif.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:elseif|否则如果|不然如果|elif|否则若)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "storage.type.function.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:function|return|lambda|func|匿名函数|def|lam|小函数|函数|定义|回传|fn|交回|返回|匿名)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "support.function.print.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:print|echo|输出|打印|显示|说)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.word.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:not|and|并且|而且|or|或者|非|且|或)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.macro.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:insert|macro|head|tail|插进去|塞进去|插入|开头|最前|结尾|开始|末尾|最后|标号|标签|宏)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.hook.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:unregister|register|before|unhook|after|hook|注册|之前|挂上|卸下|之后|摘掉|拔掉|前|后)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.language.boolean.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:nothing|什么都没有|false|null|true|nil|空值|空|真|假)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "变量": {
      "patterns": [
        {
          "begin": "(?<![\\p{L}\\p{N}_])(?:function|func|def|函数|定义|fn)(\\s+)([\\p{L}\\p{N}_]+)(\\s*)(\\()",
          "beginCaptures": {
            "0": {
              "patterns": [
                {
                  "include": "#关键字"
                }
              ]
            },
            "2": {
              "name": "entity.name.function.starlang"
            },
            "4": {
              "name": "punctuation.definition.parameters.begin.starlang"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "variable.parameter.starlang",
              "match": "[\\p{L}\\p{N}_]+"
            }
          ]
        },
        {
          "comment": "x = 值 —— 左边是新造的变量",
          "match": "^(\\s*)([\\p{L}\\p{N}_]+)(\\s*)=(?!=)",
          "captures": {
            "2": {
              "name": "variable.other.assignment.starlang"
            }
          }
        }
      ]
    },
    "内置函数": {
      "patterns": [
        {
          "name": "support.function.builtin.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:readline|replace|readall|values|append|exists|lines|trunc|write|chars|split|range|slice|isnum|strip|push|join|idiv|文件在吗|type|追加文件|keys|read|写文件|去空白|int|字符们|div|读文件|是数字|按行分|pop|has|len|读全部|读一行|范围|换成|切分|整除|含有|长度|值们|弹出|类型|取段|读檔|追加|排成|取整|键们)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "方法": {
      "patterns": [
        {
          "match": "(\\.)\\s*([\\p{L}\\p{N}_]+)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.starlang"
            },
            "2": {
              "name": "support.function.method.starlang"
            }
          }
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arithmetic.starlang",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.starlang",
          "match": "(?<!<|>|!)=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "<|>"
        },
        {
          "name": "punctuation.separator.starlang",
          "match": "[,\\[\\]{}():]"
        }
      ]
    }
  }
}
