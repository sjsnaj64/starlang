{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "星语",
  "scopeName": "source.starlang",
  "comment": "★ 这个文件是 生成语法.py 自动生成的，别手改。改词表请改 starlang.py",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#标号"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#方法"
    },
    {
      "include": "#变量"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#内置函数"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.number-sign.starlang",
          "match": "#.*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "entity.name.tag.starlang",
                  "match": "#@[\\p{L}\\p{N}_]+"
                }
              ]
            }
          }
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.starlang",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.starlang",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        }
      ]
    },
    "标号": {
      "patterns": [
        {
          "name": "entity.name.tag.starlang",
          "match": "@[\\p{L}\\p{N}_]+"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.starlang",
          "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.exception.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:catch|try|试试|出错|尝试|出事|错了)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.control.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:continue|break|while|else|loop|跳过这圈|then|退出循环|下一圈|for|逐个|不然|继续|if|如果|假如|打断|否则|只要|循环|in|重复|要是|那么|跳出|遍历|对于|若|在|于|则|当)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.elseif.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:elseif|不然如果|否则如果|elif|否则若)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "storage.type.function.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:function|return|lambda|匿名函数|func|lam|def|小函数|回传|返回|匿名|定义|交回|函数|fn)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "support.function.print.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:print|echo|输出|打印|显示|说)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.word.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:and|not|or|并且|或者|而且|非|且|或)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.macro.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:insert|macro|head|tail|插进去|塞进去|最后|末尾|标签|标号|最前|开头|开始|插入|结尾|宏)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.hook.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:unregister|register|unhook|before|after|hook|之后|注册|摘掉|之前|卸下|挂上|拔掉|后|前)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.preprocess.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:载入|引入)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.language.boolean.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:nothing|什么都没有|false|true|null|nil|空值|空|假|真)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "变量": {
      "patterns": [
        {
          "begin": "(?<![\\p{L}\\p{N}_])(?:function|func|def|定义|函数|fn)(\\s+)([\\p{L}\\p{N}_]+)(\\s*)(\\()",
          "beginCaptures": {
            "0": {
              "patterns": [
                {
                  "include": "#关键字"
                }
              ]
            },
            "2": {
              "name": "entity.name.function.starlang"
            },
            "4": {
              "name": "punctuation.definition.parameters.begin.starlang"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "variable.parameter.starlang",
              "match": "[\\p{L}\\p{N}_]+"
            }
          ]
        },
        {
          "comment": "x = 值 —— 左边是新造的变量",
          "match": "^(\\s*)([\\p{L}\\p{N}_]+)(\\s*)=(?!=)",
          "captures": {
            "2": {
              "name": "variable.other.assignment.starlang"
            }
          }
        }
      ]
    },
    "内置函数": {
      "patterns": [
        {
          "name": "support.function.builtin.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:readline|replace|readall|append|exists|values|trunc|chars|isnum|write|range|lines|split|slice|strip|文件在吗|join|read|type|追加文件|push|idiv|keys|div|按行分|字符们|读一行|去空白|len|写文件|是数字|has|读文件|pop|int|读全部|弹出|类型|含有|键们|范围|追加|读檔|取整|排成|整除|换成|取段|长度|值们|切分)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "方法": {
      "patterns": [
        {
          "match": "(\\.)\\s*([\\p{L}\\p{N}_]+)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.starlang"
            },
            "2": {
              "name": "support.function.method.starlang"
            }
          }
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arithmetic.starlang",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.starlang",
          "match": "(?<!<|>|!)=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "<|>"
        },
        {
          "name": "punctuation.separator.starlang",
          "match": "[,\\[\\]{}():]"
        }
      ]
    }
  }
}
