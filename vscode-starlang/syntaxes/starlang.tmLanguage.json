{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "星语",
  "scopeName": "source.starlang",
  "comment": "★ 这个文件是 生成语法.py 自动生成的，别手改。改词表请改 starlang.py",
  "patterns": [
    {
      "include": "#注释"
    },
    {
      "include": "#字符串"
    },
    {
      "include": "#标号"
    },
    {
      "include": "#数字"
    },
    {
      "include": "#变量"
    },
    {
      "include": "#关键字"
    },
    {
      "include": "#内置函数"
    },
    {
      "include": "#运算符"
    }
  ],
  "repository": {
    "注释": {
      "patterns": [
        {
          "name": "comment.line.number-sign.starlang",
          "match": "#.*$",
          "captures": {
            "0": {
              "patterns": [
                {
                  "name": "entity.name.tag.starlang",
                  "match": "#@[\\p{L}\\p{N}_]+"
                }
              ]
            }
          }
        }
      ]
    },
    "字符串": {
      "patterns": [
        {
          "name": "string.quoted.double.starlang",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.starlang",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.starlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.starlang",
              "match": "\\\\[ntr\\\\\"'0]|\\\\u[0-9a-fA-F]{4}|\\\\."
            }
          ]
        }
      ]
    },
    "标号": {
      "patterns": [
        {
          "name": "entity.name.tag.starlang",
          "match": "@[\\p{L}\\p{N}_]+"
        }
      ]
    },
    "数字": {
      "patterns": [
        {
          "name": "constant.numeric.starlang",
          "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?"
        }
      ]
    },
    "关键字": {
      "patterns": [
        {
          "name": "keyword.control.exception.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:catch|try|出事|出错|尝试|试试|错了)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.control.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:continue|while|break|loop|跳过这圈|退出循环|else|then|下一圈|for|逐个|对于|只要|如果|跳出|if|假如|遍历|否则|继续|要是|重复|那么|in|不然|循环|打断|若|在|则|当|于)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.elseif.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:elseif|elif|否则如果|不然如果|否则若)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "storage.type.function.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:function|lambda|return|func|匿名函数|小函数|lam|def|交回|返回|函数|定义|匿名|fn|回传)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "support.function.print.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:print|echo|打印|显示|输出|说)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.word.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:not|and|or|或者|而且|并且|非|或|且)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.macro.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:insert|macro|head|tail|插进去|塞进去|标号|最前|插入|开始|末尾|结尾|最后|开头|标签|宏)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.hook.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:unregister|register|unhook|before|after|hook|拔掉|挂上|摘掉|卸下|注册|之前|之后|后|前)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "constant.language.boolean.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:nothing|什么都没有|false|true|null|nil|空值|真|假|空)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "变量": {
      "patterns": [
        {
          "begin": "(?<![\\p{L}\\p{N}_])(?:function|func|def|函数|定义|fn)(\\s+)([\\p{L}\\p{N}_]+)(\\s*)(\\()",
          "beginCaptures": {
            "0": {
              "patterns": [
                {
                  "include": "#关键字"
                }
              ]
            },
            "2": {
              "name": "entity.name.function.starlang"
            },
            "4": {
              "name": "punctuation.definition.parameters.begin.starlang"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.starlang"
            }
          },
          "patterns": [
            {
              "name": "variable.parameter.starlang",
              "match": "[\\p{L}\\p{N}_]+"
            }
          ]
        },
        {
          "comment": "x = 值 —— 左边是新造的变量",
          "match": "^(\\s*)([\\p{L}\\p{N}_]+)(\\s*)=(?!=)",
          "captures": {
            "2": {
              "name": "variable.other.assignment.starlang"
            }
          }
        }
      ]
    },
    "内置函数": {
      "patterns": [
        {
          "name": "support.function.builtin.starlang",
          "match": "(?<![\\p{L}\\p{N}_])(?:readline|readall|replace|exists|append|values|slice|trunc|range|isnum|strip|lines|write|split|chars|type|keys|文件在吗|read|push|join|idiv|追加文件|是数字|字符们|has|int|读全部|pop|按行分|写文件|len|div|读文件|读一行|去空白|长度|类型|整除|值们|范围|换成|取段|追加|读檔|排成|切分|含有|取整|键们|弹出)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "运算符": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arithmetic.starlang",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.starlang",
          "match": "(?<!<|>|!)=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.starlang",
          "match": "<|>"
        },
        {
          "name": "punctuation.separator.starlang",
          "match": "[,\\[\\]{}():]"
        }
      ]
    }
  }
}
