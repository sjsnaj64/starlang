{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "[\\p{L}\\p{N}_]+",
  "indentationRules": {
    "increaseIndentPattern": "\\{\\s*(?:#.*)?$|^\\s*(?:function|elseif|catch|while|else|不然如果|elif|loop|func|否则如果|否则若|try|def|for|逐个|函数|不然|if|如果|假如|尝试|错了|否则|只要|循环|重复|要是|出事|试试|出错|遍历|定义|对于|fn|若|当)(?![\\w])(?![^\\n]*\\{)",
    "decreaseIndentPattern": "^\\s*(?:\\}|catch|else|出错|否则|不然|出事|错了)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:function|elseif|catch|while|else|不然如果|elif|loop|func|否则如果|否则若|try|def|for|逐个|函数|不然|if|如果|假如|尝试|错了|否则|只要|循环|重复|要是|出事|试试|出错|遍历|定义|对于|fn|若|当)(?![\\w])(?![^\\n]*\\{).*$",
      "action": {
        "indent": "increaseIndent"
      }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
