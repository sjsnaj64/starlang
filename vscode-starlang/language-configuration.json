{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "[\\p{L}\\p{N}_]+",
  "indentationRules": {
    "increaseIndentPattern": "\\{\\s*(?:#.*)?$|^\\s*(?:function|catch|while|loop|func|else|def|try|函数|尝试|如果|出事|if|假如|试试|定义|否则|要是|错了|重复|fn|不然|循环|出错|只要|若|当)(?![\\w])(?![^\\n]*\\{)",
    "decreaseIndentPattern": "^\\s*(?:\\}|catch|else|否则|不然|出事|出错|错了)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:function|catch|while|loop|func|else|def|try|函数|尝试|如果|出事|if|假如|试试|定义|否则|要是|错了|重复|fn|不然|循环|出错|只要|若|当)(?![\\w])(?![^\\n]*\\{).*$",
      "action": {
        "indent": "increaseIndent"
      }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
