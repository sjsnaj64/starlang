{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "[\\p{L}\\p{N}_]+",
  "indentationRules": {
    "increaseIndentPattern": "\\{\\s*(?:#.*)?$|^\\s*(?:function|elseif|catch|while|否则如果|else|func|不然如果|elif|loop|def|否则若|try|for|否则|不然|函数|重复|遍历|试试|定义|if|出事|只要|假如|尝试|逐个|出错|对于|错了|循环|要是|如果|fn|若|当)(?![\\w])(?![^\\n]*\\{)",
    "decreaseIndentPattern": "^\\s*(?:\\}|catch|else|否则|出错|不然|出事|错了)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:function|elseif|catch|while|否则如果|else|func|不然如果|elif|loop|def|否则若|try|for|否则|不然|函数|重复|遍历|试试|定义|if|出事|只要|假如|尝试|逐个|出错|对于|错了|循环|要是|如果|fn|若|当)(?![\\w])(?![^\\n]*\\{).*$",
      "action": {
        "indent": "increaseIndent"
      }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
