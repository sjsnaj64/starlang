# ============================================================
# 星语 Step 20 演示：下标复合赋值   表[i] += 1
# ============================================================
# 之前改表里某个位置得写两遍下标：
#
#     表[点] = 表[点] + 1
#
# 下标一长就难看了：
#
#     统计[词表[点]] = 统计[词表[点]] + 1
#
# 现在：
#
#     统计[词表[点]] += 1
# ============================================================

载入 "标准库.star"

打印 "══ 列表 ══"
数们 = [10, 20, 30]
数们[0] += 5
数们[1] -= 3
数们[2] *= 2
打印 "  " + 数们

打印 ""
打印 "══ 字典计数：最实用的场景 ══"
词 = ["苹果", "香蕉", "苹果", "橙子", "苹果", "香蕉"]
统计 = [:]
遍历 项 于 词
    如果 含有(统计, 项)
        统计[项] += 1
    否则
        统计[项] = 1
遍历 词 于 统计
    打印 "  " + 词 + " 出现 " + 统计[词] + " 次"

打印 ""
打印 "══ 嵌套下标 ══"
表格 = [[1, 2, 3], [4, 5, 6]]
表格[0][2] += 100
表格[1][0] *= 10
打印 "  " + 表格

统计2 = ["甲": [1, 2], "乙": [3, 4]]
统计2["甲"][1] += 99
打印 "  " + 统计2

打印 ""
打印 "══ 下标里塞表达式 ══"
位置 = 1
数们[位置 * 2] += 1
打印 "  " + 数们

打印 ""
打印 "══ ★ 容器和下标只求值一次 ══"
调用次数 = 0

定义 取表()
    调用次数 += 1
    返回 数们

取表()[0] += 1000
打印 "  改完之后 = " + 数们
打印 "  取表() 被调用了 " + 调用次数 + " 次（必须是 1 次）"

打印 ""
打印 "══ 取余 / 整除也能复合 ══"
值们 = [17, 23, 100]
值们[0] %= 5
值们[1] /= 2
打印 "  " + 值们

打印 ""
打印 "══ 字符串表也行 ══"
话们 = ["甲", "乙", "丙"]
话们[0] += "＋"
话们[2] += "!"
打印 "  " + 话们

打印 ""
打印 "══ 越界会报错（跟普通下标一致）══"
尝试
    数们[99] += 1
出错 错
    打印 "  " + 错
